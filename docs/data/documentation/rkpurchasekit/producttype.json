{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/rkpurchasekit\/producttype"]}],"abstract":[{"text":"The kind of an App Store product, mirroring ","type":"text"},{"type":"codeVoice","code":"StoreKit.Product.ProductType"},{"text":".","type":"text"}],"seeAlsoSections":[{"identifiers":["doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreProduct","doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreTransaction","doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreEnvironment","doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasedProductEvent","doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/AppPurchaseInfo","doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/RefundRequestStatus"],"anchor":"Products-and-transactions","title":"Products and transactions","generated":true}],"identifier":{"url":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/ProductType","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ProductType"}]}]},{"kind":"mentions","mentions":["doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/MigratingTo4"]},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A raw-value struct rather than an enum, the same pattern StoreKit uses. Up to 4.0 this was"},{"type":"text","text":" "},{"type":"text","text":"an enum, and every kind StoreKit added — as the OS 27 SDKs did with subscription bundles"},{"type":"text","text":" "},{"type":"text","text":"and suites — was a breaking change for every client with an exhaustive "},{"type":"codeVoice","code":"switch"},{"type":"text","text":". As a"},{"type":"text","text":" "},{"type":"text","text":"struct, a kind Apple adds later simply arrives with its own "},{"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/ProductType\/rawValue","isActive":true},{"type":"text","text":", and adding a"},{"type":"text","text":" "},{"type":"text","text":"constant for it here is not a breaking change. The cost is that a "},{"type":"codeVoice","code":"switch"},{"type":"text","text":" over it needs"},{"type":"text","text":" "},{"type":"text","text":"a "},{"type":"codeVoice","code":"default"},{"type":"text","text":" branch."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The raw values are StoreKit’s own, read from the framework at runtime, so a kind this"},{"type":"text","text":" "},{"type":"text","text":"build has no constant for reads exactly as StoreKit reported it — instead of being"},{"type":"text","text":" "},{"type":"text","text":"collapsed into a guess."}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"See "},{"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/ProductType","isActive":true}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"The kind of an App Store product, mirroring "},{"type":"codeVoice","code":"StoreKit.Product.ProductType"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/ProductType\/nonConsumable","isActive":true},{"type":"text","text":" – bought once and owned for good, such as a premium unlock"}]}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/ProductType\/consumable","isActive":true},{"type":"text","text":" – used up and bought again, such as in-game currency"}],