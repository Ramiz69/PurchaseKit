"type":"text"},{"code":"switch","type":"codeVoice"},{"text":" over it needs","type":"text"},{"text":" ","type":"text"},{"text":"a ","type":"text"},{"code":"default","type":"codeVoice"},{"text":" branch.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The raw values are StoreKit’s own, read from the framework at runtime, so a kind this","type":"text"},{"text":" ","type":"text"},{"text":"build has no constant for reads exactly as StoreKit reported it — instead of being","type":"text"},{"text":" ","type":"text"},{"text":"collapsed into a guess.","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/ProductType"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The kind of an App Store product, mirroring ","type":"text"},{"type":"codeVoice","code":"StoreKit.Product.ProductType"},{"text":".","type":"text"}]},{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/ProductType\/nonConsumable"},{"text":" – bought once and owned for good, such as a premium unlock","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/ProductType\/consumable","type":"reference","isActive":true},{"type":"text","text":" – used up and bought again, such as in-game currency"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/ProductType\/nonRenewable","isActive":true},{"type":"text","text":" – a subscription for a fixed period that does not renew"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/ProductType\/autoRenewable"},{"text":" – a subscription that renews until cancelled","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/ProductType\/subscriptionBundle","type":"reference","isActive":true},{"type":"text","text":" – several subscriptions sold together as one auto-renewable product"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/ProductType\/subscriptionSuite","type":"reference","isActive":true},{"text":" – a group of subscriptions that unlock each other’s content","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"Bundles and suites renew like any other auto-renewable subscription. When the question is"},{"type":"text","text":" "},{"type":"text","text":"“does this renew?”, ask "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/ProductType\/isAutoRenewableSubscription","type":"reference","isActive":true},{"type":"text","text":" instead of comparing"},{"type":"text","text":" "},{"type":"text","text":"against "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/ProductType\/autoRenewable","type":"reference","isActive":true},{"type":"text","text":": the property is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" for all three kinds, so code"},{"type":"text","text":" "},{"type":"text","text":"written against it keeps working as StoreKit adds subscription shapes."}],"type":"paragraph"},{"syntax":"swift","code":["if product.type.isAutoRenewableSubscription {","    showRenewalTerms(for: product)","}"],"type":"codeListing"},{"anchor":"A-struct-not-an-enum","level":3,"text":"A struct, not an enum","type":"heading"},{"inlineContent":[{"code":"ProductType","type":"codeVoice"},{"type":"text","text":" is a "},{"type":"codeVoice","code":"RawRepresentable"},{"type":"text","text":" struct with one constant per kind, the same pattern"},{"type":"text","text":" "},{"type":"text","text":"StoreKit uses for "},{"type":"codeVoice","code":"Product.ProductType"},{"type":"text","text":". Until 4.0 it was an enum, so every kind StoreKit added"},{"type":"text","text":" "},{"type":"text","text":"was a source-breaking change for every exhaustive "},{"type":"codeVoice","code":"switch"},{"type":"text","text":". As a struct, a kind Apple adds later"},{"type":"text","text":" "},{"type":"text","text":"arrives as itself and a constant for it can be added without breaking anyone."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/ProductType\/rawValue"},{"type":"text","text":" is StoreKit’s own ("},{"type":"codeVoice","code":"\"Consumable\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"Non-Consumable\""},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"\"Non-Renewing Subscription\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"Auto-Renewable Subscription\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"Subscription Bundle\""},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"\"Subscription Suite\""},{"type":"text","text":"), so a kind this build has no constant for reads exactly as StoreKit"},{"type":"text","text":" "},{"type":"text","text":"reported it. There is no catch-all "},{"type":"codeVoice","code":"unknown"},{"type":"text","text":" value: an unfamiliar kind is not equal to any"},{"type":"text","text":" "},{"type":"text","text":"constant, and "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/ProductType\/isAutoRenewableSubscription","type":"reference","isActive":true},{"