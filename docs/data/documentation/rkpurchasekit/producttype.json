t.RKPurchaseKit\/documentation\/RKPurchaseKit\/ProductType\/rawValue","type":"reference"},{"text":", and adding a","type":"text"},{"text":" ","type":"text"},{"text":"constant for it here is not a breaking change. The cost is that a ","type":"text"},{"code":"switch","type":"codeVoice"},{"text":" over it needs","type":"text"},{"text":" ","type":"text"},{"text":"a ","type":"text"},{"code":"default","type":"codeVoice"},{"text":" branch.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The raw values are StoreKit’s own, read from the framework at runtime, so a kind this","type":"text"},{"text":" ","type":"text"},{"text":"build has no constant for reads exactly as StoreKit reported it — instead of being","type":"text"},{"text":" ","type":"text"},{"text":"collapsed into a guess.","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"See ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/ProductType","type":"reference","isActive":true}]}]}]},{"inlineContent":[{"text":"The kind of an App Store product, mirroring ","type":"text"},{"code":"StoreKit.Product.ProductType","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/ProductType\/nonConsumable","type":"reference","isActive":true},{"text":" – bought once and owned for good, such as a premium unlock","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/ProductType\/consumable","type":"reference","isActive":true},{"text":" – used up and bought again, such as in-game currency","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/ProductType\/nonRenewable","type":"reference","isActive":true},{"text":" – a subscription for a fixed period that does not renew","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/ProductType\/autoRenewable","type":"reference","isActive":true},{"text":" – a subscription that renews until cancelled","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/ProductType\/subscriptionBundle","type":"reference","isActive":true},{"text":" – several subscriptions sold together as one auto-renewable product","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/ProductType\/subscriptionSuite","type":"reference","isActive":true},{"text":" – a group of subscriptions that unlock each other’s content","type":"text"}]}]}]},{"inlineContent":[{"text":"Bundles and suites renew like any other auto-renewable subscription. When the question is","type":"text"},{"text":" ","type":"text"},{"text":"“does this renew?”, ask ","type":"text"},{"isActive":true,"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/ProductType\/isAutoRenewableSubscription","type":"reference"},{"text":" instead of comparing","type":"text"},{"text":" ","type":"text"},{"text":"against ","type":"text"},{"isActive":true,"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/ProductType\/autoRenewable","type":"reference"},{"text":": the property is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" for all three kinds, so code","type":"text"},{"text":" ","type":"text"},{"text":"written against it keeps working as StoreKit adds subscription shapes.","type":"text"}],"type":"paragraph"},{"code":["if product.type.isAutoRenewableSubscription {","    showRenewalTerms(for: product)","}"],"syntax":"swift","type":"codeListing"},{"text":"A struct, not an enum","level":3,"anchor":"A-struct-not-an-enum","type":"heading"},{"inlineContent":[{"code":"ProductType","type":"codeVoice"},{"text":" is a ","type":"text"},{"code":"RawRepresentable","type":"codeVoice"},{"text":" struct with one constant per kind, the same pattern","type":"text"},{"text":" ","type":"text"},{"text":"StoreKit uses for ","type":"text"},{"code":"Product.ProductType","type":"codeVoice"},{"text":". Until 4.0 it was an enum, so every kind StoreKit added","type":"text"},{"text":" ","type":"text"},{"text":"was a source-breaking change for every exhaustive ","type":"text"},{"code":"switch","type":"codeVoice"},{"text":". As a struct, a kind Apple adds later","type":"text"},{"text":" ","type":"text"},{"text":"arrives as itself and a constant for it can be added without breaking anyone.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/ProductType\/rawValue","type":"reference"},{"text":" is StoreKit’s own (","type":"text"},{"code":"\"Consumable\"","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\"Non-Consumable\"","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"\"Non-Renewing Subscription\"","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\"Auto-Renewable Subscription\"","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\"Subscription Bundle\"","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"\"Subscription Suite\"","type":"codeVoice"},{"text":"), so a kind this build has no constant for reads exactly as StoreKit","type":"text"},{"text":" ","type":"text"},{"text":"reported it. There is no catch-all ","type":"text"},{"code":"unknown","type":"codeVoice"},{"text":" value: an unfamiliar kind is not equal to any","type":"text"},{"text":" ","type":"text"},{"text":"constant, and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/ProductType\/isAutoRenewableSubscription","type":"reference"},{"text":" is ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" for it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A ","type":"text"},{"code":"switch","type":"codeVoice"},{"text":" over a ","type":"text"},{"code":"ProductType","type":"codeVoice"},{"text":" matches the constants with ","type":"text"},{"code":"==","type":"codeVoice"},{"text":", and needs a ","type":"text"},{"code":"default","type":"codeVoice"},{"text":" branch:","type":"text"}],"type":"paragraph"},{"code":["switch product.type {","case .consumable, .nonConsumable, .nonRenewable:","    showOneTimePrice(product)","case .autoRenewable, .subscriptionBundle, .subscriptionSuite:","    showRenewalTerms(product)","default:","    hide(product) \/\/ A kind newer than this build: assume nothing about what it grants.","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/MigratingTo4","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"role":"symbol","title":"ProductType","navigatorTitle":[{"text":"ProductType","kind":"identifier"}],"modules":[{"name":"PurchaseKit"}],"externalID":"s:13RKPurchaseKit11ProductTypeV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ProductType","kind":"identifier"}],"symbolKind":"struct","roleHeading":"Structure"},"references":{"doc://purchasekit.RKPurchaseKit/documentation/RKPurchaseKit/MigratingTo4":{"role":"article","abstract":[{"type":"text","text":"Update an app or a test suite from PurchaseKit 3.x to 4.0."}],"kind":"article","type":"topic","url":"\/documentation\/rkpurchasekit\/migratingto4","title":"Mig