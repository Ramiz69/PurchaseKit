eeps working as StoreKit adds subscription shapes."}],"type":"paragraph"},{"code":["if product.type.isAutoRenewableSubscription {","    showRenewalTerms(for: product)","}"],"type":"codeListing","syntax":"swift"},{"text":"A struct, not an enum","anchor":"A-struct-not-an-enum","type":"heading","level":3},{"inlineContent":[{"type":"codeVoice","code":"ProductType"},{"type":"text","text":" is a "},{"type":"codeVoice","code":"RawRepresentable"},{"type":"text","text":" struct with one constant per kind, the same pattern"},{"type":"text","text":" "},{"type":"text","text":"StoreKit uses for "},{"type":"codeVoice","code":"Product.ProductType"},{"type":"text","text":". Until 4.0 it was an enum, so every kind StoreKit added"},{"type":"text","text":" "},{"type":"text","text":"was a source-breaking change for every exhaustive "},{"type":"codeVoice","code":"switch"},{"type":"text","text":". As a struct, a kind Apple adds later"},{"type":"text","text":" "},{"type":"text","text":"arrives as itself and a constant for it can be added without breaking anyone."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/ProductType\/rawValue","isActive":true},{"type":"text","text":" is StoreKit’s own ("},{"type":"codeVoice","code":"\"Consumable\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"Non-Consumable\""},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"\"Non-Renewing Subscription\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"Auto-Renewable Subscription\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"Subscription Bundle\""},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"\"Subscription Suite\""},{"type":"text","text":"), so a kind this build has no constant for reads exactly as StoreKit"},{"type":"text","text":" "},{"type":"text","text":"reported it. There is no cat