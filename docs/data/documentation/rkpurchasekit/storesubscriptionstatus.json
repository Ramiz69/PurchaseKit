 which cannot be built outside StoreKit."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The renewal state of a subscription group for the current customer."}]},{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/subscriptionStatuses(inGroup:)"},{"type":"text","text":" returns one status per subscription the"},{"type":"text","text":" "},{"type":"text","text":"customer holds in a group - usually one, more with Family Sharing."},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol\/subscriptionStatus(inGroup:)"},{"type":"text","text":" picks the one that matters most: subscribed"},{"type":"text","text":" "},{"type":"text","text":"first, then grace period, billing retry, expired and revoked, and the latest expiration date"},{"type":"text","text":" "},{"type":"text","text":"when two share a state."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the status for what an entitlement check cannot tell you: that the subscription will not"},{"type":"text","text":" "},{"type":"text","text":"renew, that a payment is failing, or which plan it renews into."}]},{"syntax":"swift","code":["guard let status = try await PurchasesManager.shared","    .subscriptionStatus(inGroup: \"com.myapp.subscriptions.premium\") else {","    showPaywall()","    return","}","","switch status.state {","case .inGracePeriod, .inBillingRetryPeriod:","    showUpdatePaymentBanner(until: status.gracePeriodExpirationDate)","case .subscribed where !status.willAutoRenew:","    showResubscribeHint(endingOn: status.transaction.expirationDate)","default:","    break","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreSubscriptionStatus\/isActive"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" while the customer should have access: subscribed or in a grace"},{"type":"text","text":" "},{"type":"text","text":"period. During a billing retry period without a grace period, the App Store has already"},{"type":"text","text":" "},{"type":"text","text":"withdrawn the entitlement."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The renewal fields come from the signed renewal info. If it fails verification they read as"},{"type":"text","text":" "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" or "},{"type":"codeVoice","code":"false"},{"type":"text","text":" rather than trusting unverified data; a status whose transaction fails"},{"type":"text","text":" "},{"type":"text","text":"verification is left out entirely."}]},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreSubscriptionStatus\/State-swift.struct"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreSubscriptionStatus\/ExpirationReason-swift.struct"},{"type":"text","text":" are "},{"type":"codeVoice","code":"RawRepresentable"},{"type":"text","text":" structs, so a "},{"type":"codeVoice","code":"switch"},{"type":"text","text":" over them"},{"type":"text","text":" "},{"type":"text","text":"needs a "},{"type":"codeVoice","code":"default"},{"type":"text","text":" branch and a future StoreKit value does not break your build."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"See "},{"type":"text","text":"doc:Subscriptions"},{"type":"text","text":"."}]}]}],"kind":"symbol","seeAlsoSections":[{"anchor":"Subscriptions","title":"Subscriptions","generated":true,"identifiers":["doc:\/\/purchasekit.RKPurch