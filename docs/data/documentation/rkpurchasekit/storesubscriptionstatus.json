y read as","type":"text"},{"text":" ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" rather than trusting unverified data; a status whose transaction fails","type":"text"},{"text":" ","type":"text"},{"text":"verification is left out entirely.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreSubscriptionStatus\/State-swift.struct","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreSubscriptionStatus\/ExpirationReason-swift.struct","isActive":true,"type":"reference"},{"text":" are ","type":"text"},{"code":"RawRepresentable","type":"codeVoice"},{"text":" structs, so a ","type":"text"},{"code":"switch","type":"codeVoice"},{"text":" over them","type":"text"},{"text":" ","type":"text"},{"text":"needs a ","type":"text"},{"code":"default","type":"codeVoice"},{"text":" branch and a future StoreKit value does not break your build.","type":"text"}]},{"inlineContent":[{"text":"See ","type":"text"},{"text":"doc:Subscriptions","type":"text"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"modules":[{"name":"PurchaseKit"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"StoreSubscriptionStatus","kind":"identifier"}],"externalID":"s:13RKPurchaseKit23StoreSubscriptionStatusV","symbolKind":"struct","role":"symbol","title":"StoreSubscriptionStatus","navigatorTitle":[{"text":"StoreSubscriptionStatus","kind":"identifier"}],"roleHeading":"Structure"},"seeAlsoSections":[{"title":"Subscriptions","identifiers":["doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/SubscriptionOffer","doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreSubscriptionPeriod"],"anchor":"Subscriptions","generated":true}],"schemaVers