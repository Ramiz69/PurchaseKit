n.displayName)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Where to get groupID?","type":"text"},{"text":" ","type":"text"},{"text":"It’s available on the product as","type":"text"},{"text":" ","type":"text"},{"text":"StoreProduct\/subscriptionGroupID (derived from Product.subscription.subscriptionGroupID) and configured in App Store Connect.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"See: "},{"type":"reference","isActive":true,"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/activeSubscriptions()"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/activeSubscription(inGroup:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreProduct\/subscriptionGroupID"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Read the renewal state - grace period, billing retry, what it renews into:"}]},{"type":"codeListing","code":["if let status = try await PurchasesManager.shared","    .subscriptionStatus(inGroup: \"com.myapp.subscriptions.premium\"),","   status.state == .inGracePeriod {","    \/\/ ask the customer to update their payment method","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"doc:Subscriptions"},{"type":"text","text":" covers status, intro-offer eligibility, promotional and win-back offers."}]},{"type":"thematicBreak"},{"type":"heading","level":2,"text":"7½  Server-verified consumables <a id=\"server-verified\"><\/a>","anchor":"7%C2%BD-Server-verified-consumables-%3Ca-id=server-verified%3E%3Ca%3E"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When your "},{"type":"strong","inlineContent":[{"type":"text","text":"server"}]},{"type":"text","text":" credits a purchase to an account - coins, tokens, credits - the device"},{"type":"text","text":" "},{"type":"text","text":"must not finish the transaction before the server has accepted it. A finished consumable is"},{"type":"text","text":" "},{"type":"text","text":"never redelivered, so finishing first and then losing the request to your server leaves the"},{"type":"text","text":" "},{"type":"text","text":"customer charged with nothing to show for it."}]},{"inlineContent":[{"type":"text","text":"Configure manual finishing and buy for the signed-in account:"}],"type":"paragraph"},{"code":["PurchasesManager.configure(identifiers: [\"com.myapp.coins.100\"], finishing: .manual)","","let (_, transaction) = try await PurchasesManager.shared","    .purchase(productID: \"com.myapp.coins.100\", appAccountToken: user.id)","","try await api.creditPurchase(signed: transaction.jwsRepresentation!) \/\/ your server verifies the JWS","await PurchasesManager.shared.finish(transaction)                    \/\/ only after it accepted"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Purchases that complete outside the call - Ask to Buy approvals, pending payments, the"},{"type":"text","text":" "},{"type":"text","text":"unfinished ones replayed at launch - arrive through "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/transactionUpdates","type":"reference","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Handle them the same way, and drain "},{"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/unfinishedTransactions()","isActive":true},{"type":"text","text":" at launch"},{"type":"text","text":" "},{"text":"and after sign-in so nothing a previous run missed is left behind. Mock the whole flow","type":"text"},{"text":" ","type":"text"},{"text":"through ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/ServerVerifiedPurchasesProtocol"},{"text":".","type":"text"}]},{"type":"thematicBreak"},{"level":2,"text":"8  Testing & mocking","anchor":"8-Testing--mocking","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Depend on PurchasesProtocol in your app code and inject a mock in tests:"}]},{"code":["struct PurchasesMock: PurchasesProtocol {","    func requestProducts(includingCache: Bool) async throws -> [StoreProduct] { [] }","    func purchase(","        productID: String,","        options: PurchaseOptions","    ) async throws -> (product: StoreProduct, transaction: StoreTransaction) {","        throw PurchasesError(.purchaseCancelled)","    }","    func restore() async throws { }","    func hasEntitlement(for productID: String) async -> Bool { productID == \"com.myapp.pro\" }","    func entitlementProductIDs() async -> Set<String> { [\"com.myapp.pro\"] }","    func activeSubscriptions() async -> [StoreProduct] { [] }","    func activeSubscription(inGroup groupID: String) async -> StoreProduct? { nil }","    func subscriptionStatuses(inGroup groupID: String) async throws -> [StoreSubscriptionStatus] { [] }","    func isEligibleForIntroOffer(inGroup groupID: String) async -> Bool { true }","    func appPurchaseInfo() async throws -> AppPurchaseInfo { throw PurchasesError(.unsupported) }","}"],"syntax":"swift","type":"codeListing"},{"text":"`purchase(productID:)` is not a requirement: it calls `purchase(productID:options:)` with ``doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchaseOptions\/none``, so the mock above answers both.","anchor":"purchaseproductID-is-not-a-requirement-it-calls-purchaseproductIDoptions-with-docpurchasekitRKPurchaseKitdocumentationRKPurchaseKitPurchaseOptionsnone-so-the-mock-above-answers-both","level":2,"type":"heading"},{"text":"9  Concurrency notes","anchor":"9-Concurrency-notes",