","level":2,"text":"2  Fetch products <a id=\"fetch-products\"><\/a>","anchor":"2-Fetch-products-%3Ca-id=fetch-products%3E%3Ca%3E"},{"code":["let products: [StoreProduct] =","    try await PurchasesManager.shared.requestProducts()"],"type":"codeListing","syntax":"swift"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Results are cached; repeat calls are instant & offline-safe."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass "},{"type":"codeVoice","code":"includingCache: false"},{"type":"text","text":" to force a fresh fetch."}]}]}]},{"type":"thematicBreak"},{"type":"heading","level":2,"text":"3  Make a purchase <a id=\"purchase\"><\/a>","anchor":"3-Make-a-purchase-%3Ca-id=purchase%3E%3Ca%3E"},{"code":["do {","    let product = try await PurchasesManager.shared","                        .purchase(productID: \"com.myapp.pro\")","    print(\"🎉 Purchased:\", product.displayName)","} catch PurchasesError.purchaseCancelled {","    \/\/ user tapped “Cancel” – usually no error UI needed","} catch {","    \/\/ handle \/ log other errors","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The call throws typed errors defined in "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesError","isActive":true,"type":"reference"},{"type":"text","text":"."}]},{"type":"thematicBreak"},{"anchor":"4-Listen-to-purchase-events","type":"heading","text":"4  Listen to purchase events","level":2},{"type":"codeListing","code":["Task {","    for await event in PurchasesManager.shared.purchasedProducts {","        \/\/ hop to the main actor if you update UI","        await MainActor.run {","            print(\"✅ Entitlement updated:\", event.product.productID)","        }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"purchasedProducts"},{"type":"text","text":" emits "},{"type":"strong","inlineContent":[{"type":"text","text":"both"}]},{"type":"text","text":" new purchases and restored entitlements,"},{"type":"text","text":" "},{"type":"text","text":"so your UI stays in sync without delegates."}]},{"type":"thematicBreak"},{"type":"heading","level":2,"text":"5  Restore past purchases","anchor":"5-Restore-past-purchases"},{"code":["try await PurchasesManager.shared.restore()"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Provide an explicit “Restore Purchases” button if required by App Store Review."}]},{"type":"thematicBreak"},{"type":"heading","level":2,"text":"6  Gate features by entitlement","anchor":"6-Gate-features-by-entitlement"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use current entitlements to unlock features (no receipt parsing needed):"}]},{"code":["let hasPro = await PurchasesManager.shared.hasEntitlement(for: \"com.myapp.pro\")","","if hasPro {","    \/\/ unlock premium UI","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or quickly check all entitled product identifiers:"}]},{"code":["let ids = await PurchasesManager.shared.entitlementProductIDs()"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":2,"text":"See: ``doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/hasEntitlement(for:)``, ``doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/entitlementProductIDs()``","anchor":"See-docpurchasekitRKPurchaseKitdocumentationRKPurchaseKitPurchasesManagerhasEntitlementfor-docpurchasekitRKPurchaseKitdocumentationRKPurchaseKitPurchasesManagerentitlementProductIDs"},{"type":"heading","level":2,"text":"7  Work with subscriptions (groups)","anchor":"7-Work-with-subscriptions-groups"},{"type":"paragraph","inlineContent":[{"type":"text","text":"List all active auto-renewable subscriptions:"}]},{"code":["let active = await 