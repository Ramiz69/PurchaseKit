{"metadata":{"modules":[{"name":"PurchaseKit"}],"roleHeading":"Article","title":"Getting Started","role":"article"},"abstract":[{"text":"Welcome to ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"RKPurchaseKit"}]},{"text":"!","type":"text"},{"text":"\n","type":"text"},{"text":"This quick guide walks you through the four-step integration flow.","type":"text"}],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"type":"thematicBreak"},{"text":"1  Configure the SDK <a id=\"configure\"><\/a>","anchor":"1-Configure-the-SDK-%3Ca-id=configure%3E%3Ca%3E","level":2,"type":"heading"},{"inlineContent":[{"text":"Call ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"once"}]},{"text":" at app launch (e.g. inside","type":"text"},{"text":" ","type":"text"},{"code":"application(_:didFinishLaunchingWithOptions:)","type":"codeVoice"},{"text":"):","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import RKPurchaseKit","","PurchasesManager.configure(identifiers: [","    \"com.myapp.pro\",","    \"com.myapp.consumable.coin\",","    \"com.myapp.sub.premium.monthly\",","    \"com.myapp.sub.premium.yearly\"","])"],"type":"codeListing"},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Tip"}]},{"type":"text","text":""},{"type":"text","text":"\n"},{"type":"text","text":"If "},{"type":"codeVoice","code":"configure(identifiers:)"},{"type":"text","text":" isn’t called, any later access to"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/shared"},{"type":"text","text":" will trap in "},{"type":"strong","inlineContent":[{"type":"text","text":"Debug"}]},{"type":"text","text":" builds to highlight the mistake."}]}],"type":"aside"},{"type":"thematicBreak"},{"text":"2  Fetch products <a id=\"fetch-products\"><\/a>","anchor":"2-Fetch-products-%3Ca-id=fetch-products%3E%3Ca%3E","level":2,"type":"heading"},{"syntax":"swift","code":["let products: [StoreProduct] =","    try await PurchasesManager.shared.requestProducts()"],"type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Results are cached; repeat calls are instant & offline-safe."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass "},{"type":"codeVoice","code":"includingCache: false"},{"type":"text","text":" to force a fresh fetch."}]}]}],"type":"unorderedList"},{"type":"thematicBreak"},{"text":"3  Make a purchase <a id=\"purchase\"><\/a>","anchor":"3-Make-a-purchase-%3Ca-id=purchase%3E%3Ca%3E","level":2,"type":"heading"},{"syntax":"swift","code":["do {","    let (product, transaction) = try await PurchasesManager.shared","                        .purchase(productID: \"com.myapp.pro\")","    print(\"🎉 Purchased:\", product.displayName, \"transaction\", transaction.id)","} catch PurchasesError.purchaseCancelled {","    \/\/ user tapped “Cancel” – usually no error UI needed","} catch {","    \/\/ handle \/ log other errors","}"],"type":"codeListing"},{"inlineContent":[{"text":"The call throws ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesError","type":"reference","isActive":true},{"text":", whose ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesError\/code-swift.property","type":"reference","isActive":true},{"text":" names the failure, including","type":"text"},{"text":" ","type":"text"},{"text":"StoreKit’s own such as ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesError\/Code-swift.struct\/networkUnavailable","type":"reference","isActive":true},{"text":". Match a code in a ","type":"text"},{"code":"catch","type":"codeVoice"},{"text":" ","type":"text"},{"text":"clause as above, or bind the error and compare its code:","type":"text"},{"text":" ","type":"text"},{"code":"catch let error as PurchasesError where error.code == .purchasePending","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To buy for an account, buy several units, or apply an offer, pass ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchaseOptions","type":"reference","isActive":true},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let options = PurchaseOptions(appAccountToken: user.id, quantity: 3)","let result = try await PurchasesManager.shared","    .purchase(productID: \"com.myapp.consumable.coin\", options: options)"],"type":"codeListing"},{"type":"thematicBreak"},{"text":"4  Listen to purchase events","anchor":"4-Listen-to-purchase-events","level":2,"type":"heading"},{"syntax":"swift","code":["Task {","    for await event in PurchasesManager.shared.purchasedProducts {","        \/\/ hop to the main actor if you update UI","        await MainActor.run {","            print(\"✅ Entitlement updated:\", event.product.productID)","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"code":"purchasedProducts","type":"codeVoice"},{"text":" emits ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"both"}]},{"text":" new purchases and restored entitlements,","type":"text"},{"text":" ","type":"text"},{"text":"so your UI stays in sync without delegates.","type":"text"}],"type":"paragraph"},{"type":"thematicBreak"},{"text":"5  Restore past purchases","anchor":"5-Restore-past-purchases","level":2,"type":"heading"},{"syntax":"swift","code":["try await PurchasesManager.shared.restore()"],"type":"codeListing"},{"inlineContent":[{"text":"Provide an explicit “Restore Purchases” button if required by App Store Review.","type":"text"}],"type":"paragraph"},{"type":"thematicBreak"},{"anchor":"6-Gate-features-by-entitlement","text":"6  Gate features by entitlement","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use current entitlements to unlock features (no receipt parsing needed):"}]},{"syntax":"swift","type":"codeListing","code":["let hasPro = await PurchasesManager.shared.hasEntitlement(for: \"com.myapp.pro\")","","if hasPro {","    \/\/ unlock premium UI","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or quickly check all entitled product identifiers:"}]},{"syntax":"swift","type":"codeListing","code":["let ids = await PurchasesManager.shared.entitlementProductIDs()"]},{"anchor":"See-docpurchasekitRKPurchaseKitdocumentationRKPurchaseKitPurchasesManagerhasEntitlementfor-docpurchasekitRKPurchaseKitdocumentationRKPurchaseKitPurchasesManagerentitlementProductIDs","text":"See: ``doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/hasEntitlement(for:)``, ``doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/entitlementProductIDs()``","type":"heading","level":2},{"anchor":"7-Work-with-subscriptions-groups","text":"7  Work with subscriptions (groups)","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"List all active auto-renewable subscriptions:"}]},{"syntax":"swift","type":"codeListing","code":["let active = await PurchasesManager.shared.activeSubscriptions()"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Select the best (latest-expiring) subscription in a group:"}]},{"syntax":"swift","type":"codeListing","code":["if let subscription = await PurchasesManager.shared.activeSubscription(inGroup: \"com.myapp.subscriptions.premium\") {","    print(\"Active plan:\", subscription.displayName)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Where to get groupID?"},{"type":"text","text":" "},{"type":"text","text":"It’s available on the product as"},{"type":"text","text":" "},{"type":"text","text":"StoreProduct\/subscriptionGroupID (derived from Product.subscription.subscriptionGroupID) and configured in App Store Connect."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"See: "},{"isActive":true,"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/activeSubscriptions()"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/activeSubscription(inGroup:)"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreProduct\/subscriptionGroupID"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Read the renewal state - grace period, billing retry, what it renews into:"}]},{"syntax":"swift","type":"codeListing","code":["if let status = try await PurchasesManager.shared","    .subscriptionStatus(inGroup: \"com.myapp.subscriptions.premium\"),","   status.state == .inGracePeriod {","    \/\/ ask the customer to update their payment method","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"doc:Subscriptions"},{"type":"text","text":" covers status, intro-offer eligibility, promotional and win-back offers."}]},{"type":"thematicBreak"},{"anchor":"7%C2%BD-Server-verified-consumables-%3Ca-id=server-verified%3E%3Ca%3E","text":"7½  Server-verified consumables <a id=\"server-verified\"><\/a>","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"When your "},{"type":"strong","inlineContent":[{"text":"server","type":"text"}]},{"type":"text","text":" credits a purchase to an account - coins, tokens, credits - the device"},{"type":"text","text":" "},{"type":"text","text":"must not finish the transaction before the server has accepted it. A finished consumable is"},{"type":"text","text":" "},{"type":"text","text":"never redelivered, so finishing first and then losing the request to your server leaves the"},{"type":"text","text":" "},{"type":"text","text":"customer charged with nothing to show for it."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Configure manual finishing and buy for the signed-in account:"}]},{"syntax":"swift","type":"codeListing","code":["PurchasesManager.configure(identifiers: [\"com.myapp.coins.100\"], finishing: .manual)","","let (_, transaction) = try await PurchasesManager.shared","    .purchase(productID: \"com.myapp.coins.100\", appAccountToken: user.id)","","try await api.creditPurchase(signed: transaction.jwsRepresentation!) \/\/ your server verifies the JWS","await PurchasesManager.shared.finish(transaction)                    \/\/ only after it accepted"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Purchases that complete outside the call - Ask to Buy approvals, pending payments, the"},{"type":"text","text":" "},{"type":"text","text":"unfinished ones replayed at launch - arrive through "},{"isActive":true,"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/transactionUpdates"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Handle them the same way, and drain "},{"isActive":true,"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/unfinishedTransactions()"},{"type":"text","text":" at launch"},{"type":"text","text":" "},{"type":"text","text":"and after sign-in so nothing a previous run missed is left behind. Mock the whole flow"},{"type":"text","text":" "},{"type":"text","text":"through "},{"isActive":true,"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/ServerVerifiedPurchasesProtocol"},{"type":"text","text":"."}]},{"type":"thematicBreak"},{"anchor":"8-Testing--mocking","text":"8  Testing & mocking","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Depend on PurchasesProtocol in your app code and inject a mock in tests:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct PurchasesMock: PurchasesProtocol {","    func requestProducts(includingCache: Bool) async throws -> [StoreProduct] { [] }","    func purchase(","        productID: String,","        options: PurchaseOptions","    ) async throws -> (product: StoreProduct, transaction: StoreTransaction) {","        throw PurchasesError(.purchaseCancelled)","    }","    func restore() async throws { }","    func hasEntitlement(for productID: String) async -> Bool { productID == \"com.myapp.pro\" }","    func entitlementProductIDs() async -> Set<String> { [\"com.myapp.pro\"] }","    func activeSubscriptions() async -> [StoreProduct] { [] }","    func activeSubscription(inGroup groupID: String) async -> StoreProduct? { nil }","    func subscriptionStatuses(inGroup groupID: String) async throws -> [StoreSubscriptionStatus] { [] }","    func isEligibleForIntroOffer(inGroup groupID: String) async -> Bool { true }","    func appPurchaseInfo() async throws -> AppPurchaseInfo { throw PurchasesError(.unsupported) }","}"]},{"anchor":"purchaseproductID-is-not-a-requirement-it-calls-purchaseproductIDoptions-with-docpurchasekitRKPurchaseKitdocumentationRKPurchaseKitPurchaseOptionsnone-so-the-mock-above-answers-both","text":"`purchase(productID:)` is not a requirement: it calls `purchase(productID:options:)` with ``doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchaseOptions\/none``, so the mock above answers both.","type":"heading","level":2},{"anchor":"9-Concurrency-notes","text":"9  Concurrency notes","type":"heading","level":2},{"anchor":"PurchasesManager-is-an-actor-so-its-API-is-thread-safe-by-design-Update-UI-on-the-main-actor-when-reacting-to-events","text":"PurchasesManager is an actor, so its API is thread-safe by design. Update UI on the main actor when reacting to events.","type":"heading","level":2},{"anchor":"Next-steps","text":"Next steps","type":"heading","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Browse Quick Help in Xcode or open the full API map:"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For unit tests, depend on "},{"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol","isActive":true},{"type":"text","text":" instead of the concrete manager."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Check "},{"inlineContent":[{"type":"text","text":"Overview"}],"type":"strong"},{"type":"text","text":" for feature list and platform requirements."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Upgrading from 3.x? Read "},{"isActive":true,"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/MigratingTo4","type":"reference"},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Happy shipping 🚀"}],"type":"paragraph"}],"kind":"content"}],"seeAlsoSections":[{"title":"Essentials","generated":true,"identifiers":["doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/MigratingTo4"],"anchor":"Essentials"}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/rkpurchasekit\/gettingstarted"]}],"hierarchy":{"paths":[["doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","identifier":{"url":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/GettingStarted","interfaceLanguage":"swift"},"references":{"doc://purchas