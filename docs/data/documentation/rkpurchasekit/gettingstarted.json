{"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/rkpurchasekit\/gettingstarted"]}],"sections":[],"abstract":[{"type":"text","text":"Welcome to "},{"type":"strong","inlineContent":[{"type":"text","text":"RKPurchaseKit"}]},{"type":"text","text":"!"},{"type":"text","text":"\n"},{"type":"text","text":"This quick guide walks you through the four-step integration flow."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/GettingStarted"},"hierarchy":{"paths":[["doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit"]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"thematicBreak"},{"type":"heading","anchor":"1-Configure-the-SDK-%3Ca-id=configure%3E%3Ca%3E","level":2,"text":"1  Configure the SDK <a id=\"configure\"><\/a>"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"type":"strong","inlineContent":[{"text":"once","type":"text"}]},{"type":"text","text":" at app launch (e.g. inside"},{"type":"text","text":" "},{"type":"codeVoice","code":"application(_:didFinishLaunchingWithOptions:)"},{"type":"text","text":"):"}]},{"type":"codeListing","syntax":"swift","code":["import RKPurchaseKit","","PurchasesManager.configure(identifiers: [","    \"com.myapp.pro\",","    \"com.myapp.consumable.coin\",","    \"com.myapp.sub.premium.monthly\",","    \"com.myapp.sub.premium.yearly\"","])"]},{"type":"aside","name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Tip","type":"text"}],"type":"strong"},{"text":"","type":"text"},{"text":"\n","type":"text"},{"text":"If ","type":"text"},{"code":"configure(identifiers:)","type":"codeVoice"},{"text":" isn’t called, any later access to","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/shared","isActive":true,"type":"reference"},{"text":" will trap in ","type":"text"},{"inlineContent":[{"text":"Debug","type":"text"}],"type":"strong"},{"text":" builds to highlight the mistake.","type":"text"}]}]},{"type":"thematicBreak"},{"type":"heading","anchor":"2-Fetch-products-%3Ca-id=fetch-products%3E%3Ca%3E","level":2,"text":"2  Fetch products <a id=\"fetch-products\"><\/a>"},{"type":"codeListing","syntax":"swift","code":["let products: [StoreProduct] =","    try await PurchasesManager.shared.requestProducts()"]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Results are cached; repeat calls are instant & offline-safe.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Pass ","type":"text"},{"code":"includingCache: false","type":"codeVoice"},{"text":" to force a fresh fetch.","type":"text"}],"type":"paragraph"}]}]},{"type":"thematicBreak"},{"type":"heading","anchor":"3-Make-a-purchase-%3Ca-id=purchase%3E%3Ca%3E","level":2,"text":"3  Make a purchase <a id=\"purchase\"><\/a>"},{"type":"codeListing","syntax":"swift","code":["do {","    let product = try await PurchasesManager.shared","                        .purchase(productID: \"com.myapp.pro\")","    print(\"🎉 Purchased:\", product.displayName)","} catch PurchasesError.purchaseCancelled {","    \/\/ user tapped “Cancel” – usually no error UI needed","} catch {","    \/\/ handle \/ log other errors","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The call throws typed errors defined in "},{"type":"reference","isActive":true,"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesError"},{"type":"text","text":"."}]},{"type":"thematicBreak"},{"type":"heading","anchor":"4-Listen-to-purchase-events","level":2,"text":"4  Listen to purchase events"},{"type":"codeListing","syntax":"swift","code":["Task {","    for await event in PurchasesManager.shared.purchasedProducts {","        \/\/ hop to the main actor if you update UI","        await MainActor.run {","            print(\"✅ Entitlement updated:\", event.product.productID)","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"purchasedProducts"},{"type":"text","text":" emits "},{"type":"strong","inlineContent":[{"text":"both","type":"text"}]},{"type":"text","text":" new purchases and restored entitlements,"},{"type":"text","text":" "},{"type":"text","text":"so your UI stays in sync without delegates."}]},{"type":"thematicBreak"},{"type":"heading","anchor":"5-Restore-past-purchases","level":2,"text":"5  Restore past purchases"},{"type":"codeListing","syntax":"swift","code":["try await PurchasesManager.shared.restore()"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Provide an explicit “Restore Purchases” button if required by App Store Review."}]},{"type":"thematicBreak"},{"type":"heading","anchor":"6-Gate-features-by-entitlement","level":2,"text":"6  Gate features by entitlement"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use current entitlements to unlock features (no receipt parsing needed):"}]},{"type":"codeListing","syntax":"swift","code":["let hasPro = await PurchasesManager.shared.hasEntitlement(for: \"com.myapp.pro\")","","if hasPro {","    \/\/ unlock premium UI","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or quickly check all entitled product identifiers:"}]},{"type":"codeListing","syntax":"swift","code":["let ids = await PurchasesManager.shared.entitlementProductIDs()"]},{"type":"heading","anchor":"See-docpurchasekitRKPurchaseKitdocumentationRKPurchaseKitPurchasesManagerhasEntitlementfor-docpurchasekitRKPurchaseKitdocumentationRKPurchaseKitPurchasesManagerentitlementProductIDs","level":2,"text":"See: ``doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/hasEntitlement(for:)``, ``doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/entitlementProductIDs()``"},{"type":"heading","anchor":"7-Work-with-subscriptions-groups","level":2,"text":"7  Work with subscriptions (groups)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"List all active auto-renewable subscriptions:"}]},{"type":"codeListing","syntax":"swift","code":["let active = await PurchasesManager.shared.activeSubscriptions()"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Select the best (latest-expiring) subscription in a group:"}]},{"type":"codeListing","syntax":"swift","code":["if let subscription = await PurchasesManager.shared.activeSubscription(inGroup: \"com.myapp.subscriptions.premium\") {","    print(\"Active plan:\", subscription.displayName)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Where to get groupID?"},{"type":"text","text":" "},{"type":"text","text":"It’s available on the product as"},{"type":"text","text":" "},{"type":"text","text":"StoreProduct\/subscriptionGroupID (derived from Product.subscription.subscriptionGroupID) and configured in App Store Connect."}]},{"type":"heading","anchor":"See-docpurchasekitRKPurchaseKitdocumentationRKPurchaseKitPurchasesManageractiveSubscriptions-docpurchasekitRKPurchaseKitdocumentationRKPurchaseKitPurchasesManageractiveSubscriptioninGroup-docpurchasekitRKPurchaseKitdocumentationRKPurchaseKitStoreProductsubscriptionGroupID","level":2,"text":"See: ``doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/activeSubscriptions()``, ``doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/activeSubscription(inGroup:)``, ``doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreProduct\/subscriptionGroupID``."},{"type":"heading","anchor":"7%C2%BD-Server-verified-consumables-%3Ca-id=server-verified%3E%3Ca%3E","level":2,"text":"7½  Server-verified consumables <a id=\"server-verified\"><\/a>"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When your "},{"type":"strong","inlineContent":[{"text":"server","type":"text"}]},{"type":"text","text":" credits a purchase to an account - coins, tokens, credits - the device"},{"type":"text","text":" "},{"type":"text","text":"must not finish the transaction before the server has accepted it. A finished consumable is"},{"type":"text","text":" "},{"type":"text","text":"never redelivered, so finishing first and then losing the request to your server leaves the"},{"type":"text","text":" "},{"type":"text","text":"customer charged with nothing to show for it."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Configure manual finishing and buy for the signed-in account:"}]},{"type":"codeListing","syntax":"swift","code":["PurchasesManager.configure(identifiers: [\"com.myapp.coins.100\"], finishing: .manual)","","let (_, transaction) = try await PurchasesManager.shared","    .purchase(productID: \"com.myapp.coins.100\", appAccountToken: user.id)","","try await api.creditPurchase(signed: transaction.jwsRepresentation!) \/\/ your server verifies the JWS","await PurchasesManager.shared.finish(transaction)                    \/\/ only after it accepted"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Purchases that complete outside the call - Ask to Buy approvals, pending payments, the"},{"type":"text","text":" "},{"type":"text","text":"unfinished ones replayed at launch - arrive through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/transactionUpdates"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Handle them the same way, and drain "},{"type":"reference","isActive":true,"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/unfinishedTransactions()"},{"type":"text","text":" at launch"},{"type":"text","text":" "},{"type":"text","text":"and after sign-in so nothing a previous run missed is left behind. Mock the whole flow"},{"type":"text","text":" "},{"type":"text","text":"through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/ServerVerifiedPurchasesProtocol"},{"type":"text","text":"."}]},{"type":"thematicBreak"},{"type":"heading","anchor":"8-Testing--mocking","level":2,"text":"8  Testing & mocking"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Depend on PurchasesProtocol in your app code and inject a mock in tests:"}]},{"type":"codeListing","syntax":"swift","code":["struct PurchasesMock: PurchasesProtocol {","    func requestProducts(includingCache: Bool) async throws -> [StoreProduct] { [] }","    func purchase(productID: String) async throws -> StoreProduct { throw PurchasesError.purchaseCancelled }","    func restore() async throws { }","    func hasEntitlement(for productID: String) async -> Bool { productID == \"com.myapp.pro\" }","    func entitlementProductIDs() async -> Set<String> { [\"com.myapp.pro\"] }","    func activeSubscriptions() async -> [StoreProduct] { [] }","    func activeSubscription(inGroup groupID: String) async -> StoreProduct? { nil }","}"]},{"type":"thematicBreak"},{"type":"heading","anchor":"9-Concurrency-notes","level":2,"text":"9  Concurrency notes"},{"type":"heading","anchor":"PurchasesManager-is-an-actor-so-its-API-is-thread-safe-by-design-Update-UI-on-the-main-actor-when-reacting-to-events","level":2,"text":"PurchasesManager is an actor, so its API is thread-safe by design. Update UI on the main actor when reacting to events."},{"type":"heading","anchor":"Next-steps","level":2,"text":"Next steps"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Browse Quick Help in Xcode or open the full API map:","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"For unit tests, depend on ","type":"text"},{"isActive":true,"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol","type":"reference"},{"text":" instead of the concrete manager.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Check ","type":"text"},{"inlineContent":[{"text":"Overview","type":"text"}],"type":"strong"},{"text":" for feature list and platform requirements.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Happy shipping 🚀"}]}]}],"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"PurchaseKit"}],"title":"Getting Started"},"references":{"doc://purchasekit.RKPurchaseKit/documentation/RKPurchaseKit/PurchasesManager/configure(identifiers:finishing:)":{"kind":"symbol","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"configure","kind":"identifier"},{"text":"(","kind":"text"},{"text":"identifiers","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"finishing","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"FinishPolicy","preciseIdentifier":"s:13RKPurchaseKit12FinishPolicyO","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"PurchasesManager","preciseIdentifier":"s:13RKPurchaseKit16PurchasesManagerC","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"Creates the singleton and starts the StoreKit transaction listener."}],"title":"configure(identifiers:finishing:)","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/configure(identifiers:finishing:)","type":"topic","url":"\/documentation\/rkpurchasekit\/purchasesmanager\/configure(identifiers:finishing:)"},"doc://purchasekit.RKPurcha