{"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit"]]},"identifier":{"url":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/GettingStarted","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Welcome to "},{"type":"strong","inlineContent":[{"type":"text","text":"RKPurchaseKit"}]},{"type":"text","text":"!"},{"type":"text","text":"\n"},{"type":"text","text":"This quick guide walks you through the four-step integration flow."}],"metadata":{"modules":[{"name":"RKPurchaseKit"}],"roleHeading":"Article","role":"article","title":"Getting Started"},"sections":[],"primaryContentSections":[{"content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"type":"thematicBreak"},{"anchor":"1-Configure-the-SDK-%3Ca-id=configure%3E%3Ca%3E","type":"heading","text":"1  Configure the SDK <a id=\"configure\"><\/a>","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"type":"strong","inlineContent":[{"type":"text","text":"once"}]},{"type":"text","text":" at app launch (e.g. inside"},{"type":"text","text":" "},{"type":"codeVoice","code":"application(_:didFinishLaunchingWithOptions:)"},{"type":"text","text":"):"}]},{"code":["import RKPurchaseKit","","PurchasesManager.configure(identifiers: [","    \"com.myapp.pro\",","    \"com.myapp.consumable.coin\",","    \"com.myapp.sub.premium.monthly\",","    \"com.myapp.sub.premium.yearly\"","])"],"type":"codeListing","syntax":"swift"},{"name":"Note","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Tip"}]},{"type":"text","text":""},{"type":"text","text":"\n"},{"type":"text","text":"If "},{"type":"codeVoice","code":"configure(identifiers:)"},{"type":"text","text":" isn’t called, any later access to"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/shared"},{"type":"text","text":" will trap in "},{"type":"strong","inlineContent":[{"type":"text","text":"Debug"}]},{"type":"text","text":" builds to highlight the mistake."}]}]},{"type":"thematicBreak"},{"anchor":"2-Fetch-products-%3Ca-id=fetch-products%3E%3Ca%3E","type":"heading","text":"2  Fetch products <a id=\"fetch-products\"><\/a>","level":2},{"code":["let products: [StoreProduct] =","    try await PurchasesManager.shared.requestProducts()"],"type":"codeListing","syntax":"swift"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Results are cached; repeat calls are instant & offline-safe."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass "},{"type":"codeVoice","code":"includingCache: false"},{"type":"text","text":" to force a fresh fetch."}]}]}]},{"type":"thematicBreak"},{"anchor":"3-Make-a-purchase-%3Ca-id=purchase%3E%3Ca%3E","type":"heading","text":"3  Make a purchase <a id=\"purchase\"><\/a>","level":2},{"code":["do {","    let product = try await PurchasesManager.shared","                        .purchase(productID: \"com.myapp.pro\")","    print(\"🎉 Purchased:\", product.displayName)","} catch PurchasesError.purchaseCancelled {","    \/\/ user tapped “Cancel” – usually no error UI needed","} catch {","    \/\/ handle \/ log other errors","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The call throws typed errors defined in "},{"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesError","isActive":true},{"type":"text","text":"."}]},{"type":"thematicBreak"},{"anchor":"4-Listen-to-purchase-events","type":"heading","text":"4  Listen to purchase events","level":2},{"code":["Task {","    for await event in PurchasesManager.shared.purchasedProducts {","        \/\/ hop to the main actor if you update UI","        await MainActor.run {","            print(\"✅ Entitlement updated:\", event.product.productID)","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"purchasedProducts"},{"type":"text","text":" emits "},{"type":"strong","inlineContent":[{"type":"text","text":"both"}]},{"type":"text","text":" new purchases and restored entitlements,"},{"type":"text","text":" "},{"type":"text","text":"so your UI stays in sync without delegates."}]},{"type":"thematicBreak"},{"anchor":"5-Restore-past-purchases","type":"heading","text":"5  Restore past purchases","level":2},{"code":["try await PurchasesManager.shared.restore()"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Provide an explicit “Restore Purchases” button if required by App Store Review."}]},{"type":"thematicBreak"},{"anchor":"6-Gate-features-by-entitlement","type":"heading","text":"6  Gate features by entitlement","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use current entitlements to unlock features (no receipt parsing needed):"}]},{"code":["let hasPro = await PurchasesManager.shared.hasEntitlement(for: \"com.myapp.pro\")","","if hasPro {","    \/\/ unlock premium UI","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or quickly check all entitled product identifiers:"}]},{"code":["let ids = await PurchasesManager.shared.entitlementProductIDs()"],"type":"codeListing","syntax":"swift"},{"anchor":"See-docpurchasekitRKPurchaseKitdocumentationRKPurchaseKitPurchasesManagerhasEntitlementfor-docpurchasekitRKPurchaseKitdocumentationRKPurchaseKitPurchasesManagerentitlementProductIDs","type":"heading","text":"See: ``doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/hasEntitlement(for:)``, ``doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/entitlementProductIDs()``