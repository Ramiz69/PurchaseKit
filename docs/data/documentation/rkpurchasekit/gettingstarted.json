mentProductIDs() async -> Set<String> { [\"com.myapp.pro\"] }","    func activeSubscriptions() async -> [StoreProduct] { [] }","    func activeSubscription(inGroup groupID: String) async -> StoreProduct? { nil }","}"],"syntax":"swift","type":"codeListing"},{"type":"thematicBreak"},{"anchor":"9-Concurrency-notes","level":2,"type":"heading","text":"9  Concurrency notes"},{"anchor":"PurchasesManager-is-an-actor-so-its-API-is-thread-safe-by-design-Update-UI-on-the-main-actor-when-reacting-to-events","level":2,"type":"heading","text":"PurchasesManager is an actor, so its API is thread-safe by design. Update UI on the main actor when reacting to events."},{"anchor":"Next-steps","level":2,"type":"heading","text":"Next steps"},{"items":[{"content":[{"inlineContent":[{"text":"Browse Quick Help in Xcode or open the full API map:","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"For unit tests, depend on ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol","isActive":true,"type":"reference"},{"text":" instead of the concrete manager.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Check ","type":"text"},{"inlineContent":[{"type":"text","text":"Overview"}],"type":"strong"},{"text":" for feature list and platform requirements.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Happy shipping 🚀","type":"text"}],"type":"paragraph"}]}],"abstract":[{"text":"Welcome to ","type":"text"},{"inlineContent":[{"type":"text","text":"RKPurchaseKit"}],"type":"strong"},{"text":"!","type":"text"},{"text":"\n","type":"text"},{"type":"text","text":"This quick guide walks you through the four-step integration flow."}],"hierarchy":{"paths":[["doc:\/\/purch