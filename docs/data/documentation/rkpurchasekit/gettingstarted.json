{"metadata":{"modules":[{"name":"RKPurchaseKit"}],"roleHeading":"Article","role":"article","title":"Getting Started"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"thematicBreak"},{"type":"heading","level":2,"text":"1  Configure the SDK <a id=\"configure\"><\/a>","anchor":"1-Configure-the-SDK-%3Ca-id=configure%3E%3Ca%3E"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"type":"strong","inlineContent":[{"type":"text","text":"once"}]},{"type":"text","text":" at app launch (e.g. inside"},{"type":"text","text":" "},{"code":"application(_:didFinishLaunchingWithOptions:)","type":"codeVoice"},{"type":"text","text":"):"}]},{"type":"codeListing","syntax":"swift","code":["import RKPurchaseKit","","PurchasesManager.configure(identifiers: [","    \"com.myapp.pro\",","    \"com.myapp.consumable.coin\",","    \"com.myapp.sub.premium.monthly\",","    \"com.myapp.sub.premium.yearly\"","])"]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Tip","type":"text"}]},{"type":"text","text":""},{"type":"text","text":"\n"},{"type":"text","text":"If "},{"type":"codeVoice","code":"configure(identifiers:)"},{"type":"text","text":" isn’t called, any later access to"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/shared","isActive":true},{"type":"text","text":" will trap in "},{"type":"strong","inlineContent":[{"text":"Debug","type":"text"}]},{"type":"text","text":" builds to highlight the mistake."}]}],"style":"note","name":"Note"},{"type":"thematicBreak"},{"type":"heading","level":2,"text":"2  Fetch products <a id=\"fetch-products\"><\/a>","anchor":"2-Fetch-products-%3Ca-id=fetch-products%3E%3Ca%3E"},{"type":"codeListing","syntax":"swift","code":["let products: [StoreProduct] =","    try await PurchasesManager.shared.requestProducts()"]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Results are cached; repeat calls are instant & offline-safe.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Pass ","type":"text"},{"code":"includingCache: false","type":"codeVoice"},{"text":" to force a fresh fetch.","type":"text"}]}]}]},{"type":"thematicBreak"},{"type":"heading","level":2,"text":"3  Make a purchase <a id=\"purchase\"><\/a>","anchor":"3-Make-a-purchase-%3Ca-id=purchase%3E%3Ca%3E"},{"type":"codeListing","syntax":"swift","code":["do {","    let product = try await PurchasesManager.shared","                        .purchase(productID: \"com.myapp.pro\")","    print(\"🎉 Purchased:\", product.displayName)","} catch PurchasesError.purchaseCancelled {","    \/\/ user tapped “Cancel” – usually no error UI needed","} catch {","    \/\/ handle \/ log other errors","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The call throws typed errors defined in "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesError","isActive":true,"type":"reference"},{"type":"text","text":"."}]},{"type":"thematicBreak"},{"type":"heading","level":2,"text":"4  Listen to purchase events","anchor":"4-Listen-to-purchase-events"},{"type":"codeListing","syntax":"swift","code":["Task {","    for await event in PurchasesManager.shared.purchasedProducts {","        \/\/ hop to the main actor if you update UI","        await MainActor.run {","            print(\"✅ Entitlement updated:\", event.product.productID)","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"code":"purchasedProducts","type":"codeVoice"},{"type":"text","text":" emits "},{"type":"strong","inlineContent":[{"type":"text","text":"both"}]},{"type":"text","text":" new purchases and restored entitlements,"},{"type":"text","text":" "},{"type":"text","text":"so your UI stays in sync without delegates."}]},{"type":"thematicBreak"},{"type":"heading","level":2,"text":"5  Restore past purchases","anchor":"5-Restore-past-purchases"},{"type":"codeListing","syntax":"swift","code":["try await PurchasesManager.shared.restore()"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Provide an explicit “Restore Purchases” button if required by App Store Review."}]},{"type":"thematicBreak"},{"type":"heading","level":2,"text":"6  Gate features by entitlement","anchor":"6-Gate-features-by-entitlement"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use current entitlements to unlock features (no receipt parsing needed):"}]},{"type":"codeListing","syntax":"swift","code":["let hasPro = await PurchasesManager.shared.hasEntitlement(for: \"com.myapp.pro\")","","if hasPro {","    \/\/ unlock premium UI","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or quickly check all entitled product identifiers:"}]},{"type":"codeListing","syntax":"swift","code":["let ids = await PurchasesManager.shared.entitlementProductIDs()"]},{"type":"heading","level":2,"text":"See: ``doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/hasEntitlement(for:)``, ``doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/entitlementProductIDs()``","anchor":"See-docpurchasekitRKPurchaseKitdocumentationRKPurchaseKitPurchasesManagerhasEntitlementfor-docpurchasekitRKPurchaseKitdocumentationRKPurchaseKitPurchasesManagerentitlementProductIDs"},{"type":"heading","level":2,"text":"7  Work with subscriptions (groups)","anchor":"7-Work-with-subscriptions-groups"},{"type":"paragraph","inlineContent":[{"type":"text","text":"List all active auto-renewable subscriptions:"}]},{"type":"codeListing","syntax":"swift","code":["let active = await PurchasesManager.shared.activeSubscriptions()"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Select the best (latest-expiring) subscription in a group:"}]},{"type":"codeListing","syntax":"swift","code":["if let subscription = await PurchasesManager.shared.activeSubscription(inGroup: \"com.myapp.subscriptions.premium\") {","    print(\"Active plan:\", subscription.displayName)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Where to get groupID?"},{"type":"text","text":" "},{"type":"text","text":"It’s available on the product as"},{"type":"text","text":" "},{"type":"text","text":"StoreProduct\/subscriptionGroupID (derived from Product.subscription.subscriptionGroupID) and configured in App Store Connect."}]},{"type":"heading","level":2,"text":"See: ``doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/activeSubscriptions()``, ``doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/activeSubscription(inGroup:)``, ``doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreProduct\/subscriptionGroupID``.","anchor":"See-docpurchasekitRKPurchaseKitdocumentationRKPurchaseKitPurchasesManageractiveSubscriptions-docpurchasekitRKPurchaseKitdocumentationRKPurchaseKitPurchasesManageractiveSubscriptioninGroup-docpurchasekitRKPurchaseKitdocumentationRKPurchaseKitStoreProductsubscriptionGroupID"},{"type":"heading","level":2,"text":"8  Testing & mocking","anchor":"8-Testing--mocking"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Depend on PurchasesProtocol in your app code and inject a mock in tests:"}]},{"type":"codeListing","syntax":"swift","code":["struct PurchasesMock: PurchasesProtocol {","    func requestProducts(includingCache: Bool) async throws -> [StoreProduct] { [] }","    func purchase(productID: String) async throws -> StoreProduct { throw PurchasesError.purchaseCancelled }","    func restore() async throws { }","    func hasEntitlement(for productID: String) async -> Bool { productID == \"com.myapp.pro\" }","    func entitlementProductIDs() async -> Set<String> { [\"com.myapp.pro\"] }","    func activeSubscriptions() async -> [StoreProduct] { [] }","    func activeSubscriptio