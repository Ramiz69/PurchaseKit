{"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"thematicBreak"},{"level":2,"anchor":"1-Configure-the-SDK-%3Ca-id=configure%3E%3Ca%3E","type":"heading","text":"1  Configure the SDK <a id=\"configure\"><\/a>"},{"inlineContent":[{"text":"Call ","type":"text"},{"inlineContent":[{"type":"text","text":"once"}],"type":"strong"},{"type":"text","text":" at app launch (e.g. inside"},{"type":"text","text":" "},{"code":"application(_:didFinishLaunchingWithOptions:)","type":"codeVoice"},{"text":"):","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import RKPurchaseKit","","PurchasesManager.configure(identifiers: [","    \"com.myapp.pro\",","    \"com.myapp.consumable.coin\",","    \"com.myapp.sub.premium.monthly\",","    \"com.myapp.sub.premium.yearly\"","])"]},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Tip"}],"type":"strong"},{"type":"text","text":""},{"type":"text","text":"\n"},{"type":"text","text":"If "},{"code":"configure(identifiers:)","type":"codeVoice"},{"type":"text","text":" isn’t called, any later access to"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/shared"},{"type":"text","text":" will trap in "},{"inlineContent":[{"type":"text","text":"Debug"}],"type":"strong"},{"type":"text","text":" builds to highlight the mistake."}],"type":"paragraph"}]},{"type":"thematicBreak"},{"type":"heading","anchor":"2-Fetch-products-%3Ca-id=fetch-products%3E%3Ca%3E","text":"2  Fetch products <a id=\"fetch-products\"><\/a>","level":2},{"type":"codeListing","syntax":"swift","code":["let products: [StoreProduct] =","    try await PurchasesManager.shared.requestProducts()"]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Results are cached; repeat calls are instant & offline-safe."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass "},{"type":"codeVoice","code":"includingCache: false"},{"type":"text","text":" to force a fresh fetch."}]}]}]},{"type":"thematicBreak"},{"text":"3  Make a purchase <a id=\"purchase\"><\/a>","type":"heading","level":2,"anchor":"3-Make-a-purchase-%3Ca-id=purchase%3E%3Ca%3E"},{"syntax":"swift","type":"codeListing","code":["do {","    let product = try await PurchasesManager.shared","                        .purchase(productID: \"com.myapp.pro\")","    print(\"🎉 Purchased:\", product.displayName)","} catch PurchasesError.purchaseCancelled {","    \/\/ user tapped “Cancel” – usually no error UI needed","} catch {","    \/\/ handle \/ log other errors","}"]},{"inlineContent":[{"text":"The call throws typed errors defined in ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesError"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"thematicBreak"},{"text":"4  Listen to purchase events","type":"heading","level":2,"anchor":"4-Listen-to-purchase-events"},{"syntax":"swift","type":"codeListing","code":["Task {","    for await event in PurchasesManager.shared.purchasedProducts {","        \/\/ hop to the main actor if you update UI","        await MainActor.run {","            print(\"✅ Entitlement updated:\", event.product.productID)","        }","    }","}"]},{"inlineContent":[{"code":"purchasedProducts","type":"codeVoice"},{"type":"text","text":" emits "},{"inlineContent":[{"type":"text","text":"both"}],"type":"strong"},{"type":"text","text":" new purchases and restored entitlements,"},{"type":"text","text":" "},{"type":"text","text":"so your UI stays in sync without delegates."}],"type":"paragraph"},{"type":"thematicBreak"},{"text":"5  Restore past purchases","anchor":"5-Restore-past-purchases","level":2,"type":"heading"},{"type":"codeListing","syntax":"swift","code":["try await PurchasesManager.shared.restore()"]},{"inlineContent":[{"text":"Provide an explicit “Restore Purchases” button if required by App Store Review.","type":"text"}],"type":"paragraph"},{"type":"thematicBreak"},{"text":"6  Gate features by entitlement","anchor":"6-Gate-features-by-entitlement","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Use current entitlements to unlock features (no receipt parsing needed):"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let hasPro = await PurchasesManager.shared.hasEntitlement(for: \"com.myapp.pro\")","","if hasPro {","    \/\/ unlock premium UI","}"]},{"inlineContent":[{"type":"text","text":"Or quickly check all entitled product identifiers:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let ids = await PurchasesManager.shared.entitlementProductIDs()"]},{"text":"See: ``doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/hasEntitlement(for:)``, ``doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/entitlementProductIDs()``","anchor":"See-docpurchasekitRKPurchaseKitdocumentationRKPurchaseKitPurchasesManagerhasEntitlementfor-docpurchasekitRKPurchaseKitdocumentationRKPurchaseKitPurchasesManagerentitlementProductIDs","level":2,"type":"heading"},{"text":"7  Work with subscriptions (groups)","anchor":"7-Work-with-subscriptions-groups","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"List all active auto-renewable subscriptions:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let active = await PurchasesManager.shared.activeSubscriptions()"]},{"inlineContent":[{"type":"text","text":"Select the best (latest-expiring) subscription in a group:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["if let subscription = await PurchasesManager.shared.activeSubscription(inGroup: \"com.myapp.subscriptions.premium\") {","    print(\"Active plan:\", subscription.displayName)","}"]},{"inlineContent":[{"type":"text","text":"Where to get groupID?"},{"type":"text","text":" "},{"type":"text","text":"It’s available on the product as"},{"type":"text","text":" "},{"type":"text","text":"StoreProduct\/subscriptionGroupID (derived from Product.subscription.subscriptionGroupID) and configured in App Store Connect."}],"type":"paragraph"},{"text":"See: ``doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/activeSubscriptions()``, ``doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/activeSubscription(inGroup:)``, ``doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreProduct\/subscriptionGroupID``.","anchor":"See-docpurchasekitRKPurchaseKitdocumentationRKPurchaseKitPurchasesManageractiveSubscriptions-docpurchasekitRKPurchaseKitdocumentationRKPurchaseKitPurchasesManageractiveSubscriptioninGroup-docpurchasekitRKPurchaseKitdocumentationRKPurchaseKitStoreProductsubscriptionGroupID","level":2,"type":"heading"},{"text":"8  Testing & mocking","anchor":"8-Testing--mocking","level":2,"type":"heading"},{"inlineContent":[{"text":"Depend on PurchasesProtocol in your app code and inject a mock in tests:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct PurchasesMock: PurchasesProtocol {","    func requestProducts(includingCache: Bool) async throws -> [StoreProduct] { [] }","    func purchase(productID: String) async throws -> StoreProduct { throw PurchasesError.purchaseCancelled }","    func restore() async throws { }","    func hasEntitlement(for productID: String) async -> Bool { productID == \"com.myapp.pro\" }","    func entitlementProductIDs() async -> Set<String> { [\"com.myapp.pro\"] }","    func activeSubscriptions() async -> [StoreProduct] { [] }","    func activeSubscription(inGroup groupID: String) async -> StoreProduct? { nil }","}"]},{"type":"thematicBreak"},{"text":"9  Concurrency notes","anchor":"9-Concurrency-notes","level":2,"type":"heading"},{"text":"PurchasesManager is an actor, so its API is thread-safe by design. Update UI on the main actor when reacting to events.","anchor":"PurchasesManager-is-an-actor-so-its-API-is-thread-safe-by-design-Update-UI-on-the-main-actor-when-reacting-to-events","level":2,"type":"heading"},{"text":"Next steps","anchor":"Next-steps","level":2,"type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Browse Quick Help in Xcode or open the full API map:","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For unit tests, depend on "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol","isActive":true,"type":"reference"},{"text":" instead of the concrete manager.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Check ","type":"text"},{"inlineContent":[{"type":"text","text":"Overview"}],"type":"strong"},{"text":" for feature list and platform requirements.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Happy shipping 🚀"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"roleHeading":"Article","title":"Getting Started","modules":[{"name":"PurchaseKit"}],"role":"article"},"hierarchy":{"paths":[["doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit"]]},"abstract":[{"text":"Welcome to ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"RKPurchaseKit"}]},{"text":"!","type":"text"},{"text":"\n","type":"text"},{"text":"This quick guide walks you through the four-step integration flow.","type":"text"}],"sections":[],"identifier":{"url":"doc:\/\/purchasekit.RKPurchaseKit\/docu