{"sections":[],"identifier":{"url":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/GettingStarted","interfaceLanguage":"swift"},"metadata":{"title":"Getting Started","roleHeading":"Article","modules":[{"name":"PurchaseKit"}],"role":"article"},"primaryContentSections":[{"content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"type":"thematicBreak"},{"level":2,"anchor":"1-Configure-the-SDK-%3Ca-id=configure%3E%3Ca%3E","text":"1  Configure the SDK <a id=\"configure\"><\/a>","type":"heading"},{"inlineContent":[{"type":"text","text":"Call "},{"inlineContent":[{"text":"once","type":"text"}],"type":"strong"},{"type":"text","text":" at app launch (e.g. inside"},{"type":"text","text":" "},{"code":"application(_:didFinishLaunchingWithOptions:)","type":"codeVoice"},{"type":"text","text":"):"}],"type":"paragraph"},{"code":["import RKPurchaseKit","","PurchasesManager.configure(identifiers: [","    \"com.myapp.pro\",","    \"com.myapp.consumable.coin\",","    \"com.myapp.sub.premium.monthly\",","    \"com.myapp.sub.premium.yearly\"","])"],"syntax":"swift","type":"codeListing"},{"style":"note","name":"Note","content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Tip"}]},{"text":"","type":"text"},{"text":"\n","type":"text"},{"text":"If ","type":"text"},{"code":"configure(identifiers:)","type":"codeVoice"},{"text":" isn’t called, any later access to","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/shared"},{"text":" will trap in ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Debug"}]},{"text":" builds to highlight the mistake.","type":"text"}],"type":"paragraph"}],"type":"aside"},{"type":"thematicBreak"},{"level":2,"anchor":"2-Fetch-products-%3Ca-id=fetch-products%3E%3Ca%3E","text":"2  Fetch products <a id=\"fetch-products\"><\/a>","type":"heading"},{"code":["let products: [StoreProduct] =","    try await PurchasesManager.shared.requestProducts()"],"syntax":"swift","type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Results are cached; repeat calls are instant & offline-safe."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass "},{"type":"codeVoice","code":"includingCache: false"},{"type":"text","text":" to force a fresh fetch."}]}]}],"type":"unorderedList"},{"type":"thematicBreak"},{"level":2,"anchor":"3-Make-a-purchase-%3Ca-id=purchase%3E%3Ca%3E","text":"3  Make a purchase <a id=\"purchase\"><\/a>","type":"heading"},{"code":["do {","    let (product, transaction) = try await PurchasesManager.shared","                        .purchase(productID: \"com.myapp.pro\")","    print(\"🎉 Purchased:\", product.displayName, \"transaction\", transaction.id)","} catch PurchasesError.purchaseCancelled {","    \/\/ user tapped “Cancel” – usually no error UI needed","} catch {","    \/\/ handle \/ log other errors","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The call throws "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesError","type":"reference","isActive":true},{"type":"text","text":", whose "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesError\/code-swift.property","type":"reference","isActive":true},{"type":"text","text":" names the failure, including"},{"type":"text","text":" "},{"type":"text","text":"StoreKit’s own such as "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesError\/Code-swift.struct\/networkUnavailable","type":"reference","isActive":true},{"type":"text","text":". Match a code in a "},{"code":"catch","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"clause as above, or bind the error and compare its code:"},{"type":"text","text":" "},{"code":"catch let error as PurchasesError where error.code == .purchasePending","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To buy for an account, buy several units, or apply an offer, pass "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchaseOptions","type":"reference","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"code":["let options = PurchaseOptions(appAccountToken: user.id, quantity: 3)","let result = try await PurchasesManager.shared","    .purchase(productID: \"com.myapp.consumable.coin\", options: options)"],"syntax":"swift","type":"codeListing"},{"type":"thematicBreak"},{"level":2,"anchor":"4-Listen-to-purchase-events","text":"4  Listen to purchase events","type":"heading"},{"code":["Task {","    for await event in PurchasesManager.shared.purchasedProducts {","        \/\/ hop to the main actor if you update UI","        await MainActor.run {","            print(\"✅ Entitlement updated:\", event.product.productID)","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"code":"purchasedProducts","type":"codeVoice"},{"text":" emits ","type":"text"},{"inlineContent":[{"type":"text","text":"both"}],"type":"strong"},{"text":" new purchases and restored entitlements,","type":"text"},{"text":" ","type":"text"},{"text":"so your UI stays in sync without delegates.","type":"text"}]},{"type":"thematicBreak"},{"level":2,"anchor":"5-Restore-past-purchases","text":"5  Restore past purchases","type":"heading"},{"type":"codeListing","syntax":"swift","code":["try await PurchasesManager.shared.restore()"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Provide an explicit “Restore Purchases” button if required by App Store Review."}]},{"type":"thematicBreak"},{"level":2,"type":"heading","anchor":"6-Gate-features-by-entitlement","text":"6  Gate features by entitlement"},{"type":"paragraph","inlineContent":[{"text":"Use current entitlements to unlock features (no receipt parsing needed):","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let hasPro = await PurchasesManager.shared.hasEntitlement(for: \"com.myapp.pro\")","","if hasPro {","    \/\/ unlock premium UI","}"]},{"type":"paragraph","inlineContent":[{"text":"When the answer needs a date, ask for the transaction instead. A free trial unlocked through","type":"text"},{"text":" ","type":"text"},{"text":"a non-consumable is the typical case: its end is computed from the purchase date, which comes","type":"text"},{"text":" ","type":"text"},{"text":"from the App Store, so it survives a reinstall and is the same on every device of the account.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["if let trial = await PurchasesManager.shared.currentEntitlement(for: \"com.myapp.trial\") {","    let trialEnds = trial.purchaseDate.addingTimeInterval(14 * 24 * 60 * 60)","    \/\/ trial.isFamilyShared tells an own purchase from a Family Sharing grant","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or quickly check all entitled product identifiers:"}]},{"syntax":"swift","type":"codeListing","code":["let ids = await PurchasesManager.shared.entitlementProductIDs()"]},{"level":2,"type":"heading","text":"See: ``doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/hasEntitlement(for:)``, ``doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/currentEntitlement(for:)``, ``doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/entitlementProductIDs()``","anchor":"See-docpurchasekitRKPurchaseKitdocumentationRKPurchaseKitPurchasesManagerhasEntitlementfor-docpurchasekitRKPurchaseKitdocumentationRKPurchaseKitPurchasesManagercurrentEntitlementfor-docpurchasekitRKPurchaseKitdocumentationRKPurchaseKitPurchasesManagerentitlementProductIDs"},{"level":2,"type":"heading","anchor":"7-Work-with-subscriptions-groups","text":"7  Work with subscriptions (groups)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"List all active auto-renewable subscriptions:"}]},{"syntax":"swift","type":"codeListing","code":["let active = await PurchasesManager.shared.activeSubscriptions()"]},{"type":"paragraph","inlineContent":[{"text":"Select the best (latest-expiring) subscription in a group:","type":"text"}]},{"code":["if let subscription = await PurchasesManager.shared.activeSubscription(inGroup: \"com.myapp.subscriptions.premium\") {","    print(\"Active plan:\", subscription.displayName)","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Where to get groupID?","type":"text"},{"text":" ","type":"text"},{"text":"It’s available on the product as","type":"text"},{"text":" ","type":"text"},{"text":"StoreProduct\/subscriptionGroupID (derived from Product.subscription.subscriptionGroupID) and configured in App Store Connect.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"See: ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/activeSubscriptions()"},{"text":", ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/activeSubscription(inGroup:)"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreProduct\/subscriptionGroupID"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Read the renewal state - grace period, billing retry, what it renews into:","type":"text"}],"type":"paragraph"},{"code":["if let status = try await PurchasesManager.shared","    .subscriptionStatus(inGroup: \"com.myapp.subscriptions.premium\"),","   status.state == .inGracePeriod {","    \/\/ ask the customer to update their payment method","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"doc:Subscriptions","type":"text"},{"type":"text","text":" covers status, intro-offer eligibility, promotional and win-back offers."}],"type":"paragraph"},{"type":"thematicBreak"},{"level":2,"type":"heading","anchor":"7%C2%BD-Server-verified-consumables-%3Ca-id=server-verified%3E%3Ca%3E","text":"7½  Server-verified consumables <a id=\"server-verified\"><\/a>"},{"inlineContent":[{"type":"text","text":"When your "},{"inlineContent":[{"text":"server","type":"text"}],"type":"strong"},{"type":"text","text":" credits a purchase to an account - coins, tokens, credits - the device"},{"type":"text","text":" "},{"type":"text","text":"must not finish the transaction before the server has accepted it. A finished consumable is"},{"type":"text","text":" "},{"type":"text","text":"never redelivered, so finishing first and then losing the request to your server leaves the"},{"type":"text","text":" "},{"type":"text","text":"customer charged with nothing to show for it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Configure manual finishing and buy for the signed-in account:"}],"type":"paragraph"},{"code":["PurchasesManager.configure(identifiers: [\"com.myapp.coins.100\"], finishing: .manual)","","let (_, transaction) = try await PurchasesManager.shared","    .purchase(productID: \"com.myapp.coins.100\", appAccountToken: user.id)","","try await api.creditPurchase(signed: transaction.jwsRepresentation!) \/\/ your server verifies the JWS","await PurchasesManager.shared.finish(transaction)                    \/\/ only after it accepted"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Purchases that complete outside the call - Ask to Buy approvals, pending payments, the"},{"type":"text","text":" "},{"type":"text","text":"unfinished ones replayed at launch - arrive through "},{"isActive":true,"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/transactionUpdates"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Handle them the same way, and drain "},{"isActive":true,"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/unfinishedTransactions()"},{"type":"text","text":" at launch"},{"type":"text","text":" "},{"type":"text","text":"and after sign-in so nothing a previous run missed is left behind. Mock the whole flow"},{"type":"text","text":" "},{"text":"through ","type":"text"},{"isActive":true,"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/ServerVerifiedPurchasesProtocol","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"thematicBreak"},{"type":"heading","level":2,"text":"8  Testing & mocking","anchor":"8-Testing--mocking"},{"inlineContent":[{"text":"Depend on PurchasesProtocol in your app code and inject a mock in tests:","type":"text"}],"type":"paragraph"},{"code":["struct PurchasesMock: PurchasesProtocol {","    func requestProducts(includingCache: Bool) async throws -> [StoreProduct] { [] }","    func purchase(","        productID: String,","        options: PurchaseOptions","    ) async throws -> (product: StoreProduct, transaction: StoreTransaction) {","        throw PurchasesError(.purchaseCancelled)","    }","    func restore() async throws { }","    func hasEntitlement(for productID: String) async -> Bool { productID == \"com.myapp.pro\" }","    func entitlementProductIDs() async -> Set<String> { [\"com.myapp.pro\"] }","    func activeSubscriptions() async -> [StoreProduct] { [] }","    func activeSubscription(inGroup groupID: String) async -> StoreProduct? { nil }","    func subscriptionStatuses(inGroup groupID: String) async throws -> [StoreSubscriptionStatus] { [] }","    func isEligibleForIntroOffer(inGroup groupID: String) async -> Bool { true }","    func appPurchaseInfo() async throws -> AppPurchaseInfo { throw PurchasesError(.unsupported) }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"purchase(productID:)","type":"codeVoice"},{"type":"text","text":" is not a requirement: it calls "},{"code":"purchase(productID:options:)","type":"codeVoice"},{"type":"text","text":" with"},{"type":"text","text":" "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchaseOptions\/none","type":"reference","isActive":true},{"type":"text","text":", so the mock above answers both."}]},{"level":2,"type":"heading","text":"``doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol\/currentEntitlement(for:)`` has a default that returns `nil`, so the mock compiles without it. A mock that reports an entitlement from `hasEntitlement(for:)` should answer it too, with a transaction built by ``doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreTransaction``’s public initializer; otherwise the two disagree.","anchor":"docpurchasekitRKPurchaseKitdocumentationRKPurchaseKitPurchasesProtocolcurrentEntitlementfor-has-a-default-that-returns-nil-so-the-mock-compiles-without-it-A-mock-that-reports-an-entitlement-from-hasEntitlementfor-should-answer-it-too-with-a-transaction-built-by-docpurchasekitRKPurchaseKitdocumentationRKPurchaseKitStoreTransactions-public-initializer-otherwise-the-two-disagree"},{"level":2,"type":"heading","text":"9  Concurrency notes","anchor":"9-Concurrency-notes"},{"level":2,"type":"heading","text":"PurchasesManager is an actor, so its API is thread-safe by design. Update UI on the main actor when reacting to events.","anchor":"PurchasesManager-is-an-actor-so-its-API-is-thread-safe-by-design-Update-UI-on-the-main-actor-when-reacting-to-events"},{"level":2,"type":"heading","text":"Next steps","anchor":"Next-steps"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Browse Quick Help in Xcode or open the full API map:"},{"type":"tex