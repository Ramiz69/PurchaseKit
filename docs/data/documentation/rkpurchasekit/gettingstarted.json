{"primaryContentSections":[{"content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"type":"thematicBreak"},{"text":"1  Configure the SDK <a id=\"configure\"><\/a>","anchor":"1-Configure-the-SDK-%3Ca-id=configure%3E%3Ca%3E","level":2,"type":"heading"},{"inlineContent":[{"text":"Call ","type":"text"},{"inlineContent":[{"text":"once","type":"text"}],"type":"strong"},{"text":" at app launch (e.g. inside","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"application(_:didFinishLaunchingWithOptions:)"},{"text":"):","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import RKPurchaseKit","","PurchasesManager.configure(identifiers: [","    \"com.myapp.pro\",","    \"com.myapp.consumable.coin\",","    \"com.myapp.sub.premium.monthly\",","    \"com.myapp.sub.premium.yearly\"","])"]},{"type":"aside","content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Tip"}],"type":"strong"},{"type":"text","text":""},{"type":"text","text":"\n"},{"type":"text","text":"If "},{"type":"codeVoice","code":"configure(identifiers:)"},{"type":"text","text":" isn’t called, any later access to"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/shared"},{"type":"text","text":" will trap in "},{"inlineContent":[{"type":"text","text":"Debug"}],"type":"strong"},{"type":"text","text":" builds to highlight the mistake."}],"type":"paragraph"}],"name":"Note","style":"note"},{"type":"thematicBreak"},{"level":2,"type":"heading","text":"2  Fetch products <a id=\"fetch-products\"><\/a>","anchor":"2-Fetch-products-%3Ca-id=fetch-products%3E%3Ca%3E"},{"type":"codeListing","syntax":"swift","code":["let products: [StoreProduct] =","    try await PurchasesManager.shared.requestProducts()"]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Results are cached; repeat calls are instant & offline-safe.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Pass ","type":"text"},{"type":"codeVoice","code":"includingCache: false"},{"text":" to force a fresh fetch.","type":"text"}]}]}]},{"type":"thematicBreak"},{"type":"heading","text":"3  Make a purchase <a id=\"purchase\"><\/a>","level":2,"anchor":"3-Make-a-purchase-%3Ca-id=purchase%3E%3Ca%3E"},{"code":["do {","    let product = try await PurchasesManager.shared","                        .purchase(productID: \"com.myapp.pro\")","    print(\"🎉 Purchased:\", product.displayName)","} catch PurchasesError.purchaseCancelled {","    \/\/ user tapped “Cancel” – usually no error UI needed","} catch {","    \/\/ handle \/ log other errors","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The call throws typed errors defined in ","type":"text"},{"isActive":true,"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesError","type":"reference"},{"text":".","type":"text"}]},{"type":"thematicBreak"},{"type":"heading","text":"4  Listen to purchase events","level":2,"anchor":"4-Listen-to-purchase-events"},{"code":["Task {","    for await event in PurchasesManager.shared.purchasedProducts {","        \/\/ hop to the main actor if you update UI","        await MainActor.run {","            print(\"✅ Entitlement updated:\", event.product.productID)","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"purchasedProducts"},{"type":"text","text":" emits "},{"inlineContent":[{"text":"both","type":"text"}],"type":"strong"},{"type":"text","text":" new purchases and restored entitlements,"},{"type":"text","text":" "},{"type":"text","text":"so your UI stays in sync without delegates."}]},{"type":"thematicBreak"},{"type":"heading","text":"5  Restore past purchases","level":2,"anchor":"5-Restore-past-purchases"},{"code":["try await PurchasesManager.shared.restore()"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Provide an explicit “Restore Purchases” button if required by App Store Review.","type":"text"}]},{"type":"thematicBreak"},{"type":"heading","text":"6  Gate features by entitlement","level":2,"anchor":"6-Gate-features-by-entitlement"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use current entitlements to unlock features (no receipt parsing needed):"}]},{"code":["let hasPro = await PurchasesManager.shared.hasEntitlement(for: \"com.myapp.pro\")","","if hasPro {","    \/\/ unlock premium UI","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Or quickly check all entitled product identifiers:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let ids = await PurchasesManager.shared.entitlementProductIDs()"]},{"text":"See: ``doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/hasEntitlement(for:)``, ``doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/entitlementProductIDs()``","anchor":"See-docpurchasekitRKPurchaseKitdocumentationRKPurchaseKitPurchasesManagerhasEntitlementfor-docpurchasekitRKPurchaseKitdocumentationRKPurchaseKitPurchasesManagerentitlementProductIDs","type":"heading","level":2},{"text":"7  Work with subscriptions (groups)","anchor":"7-Work-with-subscriptions-groups","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"List all active auto-renewable subscriptions:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let active = await PurchasesManager.shared.activeSubscriptions()"]},{"type":"paragraph","inlineContent":[{"text":"Select the best (latest-expiring) subscription in a group:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["if let subscription = await PurchasesManager.shared.activeSubscription(inGroup: \"com.myapp.subscriptions.premium\") {","    print(\"Active plan:\", subscription.displayName)","}"]},{"type":"paragraph","inlineContent":[{"text":"Where to get groupID?","type":"text"},{"text":" ","type":"text"},{"text":"It’s available on the product as","type":"text"},{"type":"text","text":" "},{"type":"text","text":"StoreProduct\/subscriptionGroupID (derived from Product.subscription.subscriptionGroupID) and configured in App Store Connect."}]},{"type":"heading","text":"See: ``doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/activeSubscriptions()``, ``doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/activeSubscription(inGroup:)``, ``doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreProduct\/subscriptionGroupID``.","level":2,"anchor":"See-docpurchasekitRKPurchaseKitdocumentationRKPurchaseKitPurchasesManageractiveSubscriptions-docpurchasekitRKPurchaseKitdocumentationRKPurchaseKitPurchasesManageractiveSubscriptioninGroup-docpurchasekitRKPurchaseKitdocumentationRKPurchaseKitStoreProductsubscriptionGroupID"},{"type":"heading","text":"8  Testing & mocking","level":2,"anchor":"8-Testing--mocking"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Depend on PurchasesProtocol in your app code and inject a mock in tests:"}]},{"syntax":"swift","type":"codeListing","code":["struct PurchasesMock: PurchasesProtocol {","    func requestProducts(includingCache: Bool) async throws -> [StoreProduct] { [] }","    func purchase(productID: String) async throws -> StoreProduct { throw PurchasesError.purchaseCancelled }","    func restore() async throws { }","    func hasEntitlement(for productID: String) async -> Bool { productID == \"com.myapp.pro\" }","    func entitlementProductIDs() async -> Set<String> { [\"com.myapp.pro\"] }","    func activeSubscriptions() async -> [StoreProduct] { [] }","    func activeSubscription(inGroup groupID: String) async -> StoreProduct? { nil }","}"]},{"type":"thematicBreak"},{"text":"9  Concurrency notes","type":"heading","anchor":"9-Concurrency-notes","level":2},{"text":"PurchasesManager is an actor, so its API is thread-safe by design. Update UI on the main actor when reacting to events.","anchor":"PurchasesManager-is-an-actor-so-its-API-is-thread-safe-by-design-Update-UI-on-the-main-actor-when-reacting-to-events","type":"heading","level":2},{"text":"Next steps","anchor":"Next-steps","type":"heading","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Browse Quick Help in Xcode or open the full API map:"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"text":"For unit tests, depend on ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol","isActive":true,"type":"reference"},{"text":" instead of the concrete manager.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Check "},{"type":"strong","inlineContent":[{"type":"text","text":"Overview"}]},{"type":"text","text":" for feature list and platform requirements."}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Happy shipping 🚀","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/rkpurchasekit\/gettingstarted"]}],"abstract":[{"text":"Welcome to ","type":"text"},{"inlineContent":[{"text":"RKPurchaseKit","type":"text"}],"type":"strong"},{"text":"!","type":"text"},{"text":"\n","type":"text"},{"type":"text","text":"This quick guide walks you through the four-step integration flow."}],"identifier":{"url":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/GettingStarted","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"modules":[{"name":"RKPurchaseKit"}],"ro