{"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"roleHeading":"Article","modules":[{"name":"PurchaseKit"}],"role":"article","title":"Subscriptions"},"hierarchy":{"paths":[["doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/rkpurchasekit\/subscriptions"]}],"kind":"article","sections":[],"abstract":[{"type":"text","text":"Read renewal state, react to billing problems, and sell introductory, promotional and"},{"type":"text","text":" "},{"type":"text","text":"win-back offers."}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"An entitlement check answers one question: may the customer use the feature right now? A","type":"text"},{"text":" ","type":"text"},{"text":"subscription app usually needs more - whether the subscription will renew, whether a payment","type":"text"},{"text":" ","type":"text"},{"text":"is failing, which offer this customer may see. ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreSubscriptionStatus","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/SubscriptionOffer","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchaseOptions","type":"reference","isActive":true},{"text":" cover that ground.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The examples use one subscription group:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let groupID = \"com.myapp.subscriptions.premium\""]},{"type":"paragraph","inlineContent":[{"text":"The group ID is configured in App Store Connect and available as","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreProduct\/subscriptionGroupID","type":"reference","isActive":true},{"text":".","type":"text"}]},{"type":"heading","level":2,"anchor":"Read-the-subscription-status","text":"Read the subscription status"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol\/subscriptionStatus(inGroup:)","type":"reference","isActive":true},{"text":" returns the status that matters most for a","type":"text"},{"text":" ","type":"text"},{"text":"group, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when the customer has never subscribed to it:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let status = try await PurchasesManager.shared.subscriptionStatus(inGroup: groupID)","","if let status {","    print(status.state.rawValue, status.isActive)","    print(\"Renews:\", status.willAutoRenew, \"on\", status.renewalDate ?? .distantPast)","    print(\"Into:\", status.autoRenewProductID ?? \"-\")","}"]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreSubscriptionStatus\/isActive","type":"reference","isActive":true},{"text":" follows the App Store’s rule for access: subscribed or in a","type":"text"},{"text":" ","type":"text"},{"text":"grace period. ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreSubscriptionStatus\/transaction","type":"reference","isActive":true},{"text":" is the latest transaction behind the status,","type":"text"},{"text":" ","type":"text"},{"text":"so its ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreTransaction\/expirationDate","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreTransaction\/offer-swift.property","type":"reference","isActive":true},{"text":" describe the current","type":"text"},{"text":" ","type":"text"},{"text":"period.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreSubscriptionStatus\/autoRenewProductID","type":"reference","isActive":true},{"text":" differs from the transaction’s","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreTransaction\/productID","type":"reference","isActive":true},{"text":", the customer has scheduled an upgrade, downgrade or","type":"text"},{"text":" ","type":"text"},{"text":"crossgrade that takes effect at the next renewal.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"With Family Sharing a customer can hold more than one status in a group. Read them all with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/subscriptionStatuses(inGroup:)","type":"reference","isActive":true},{"text":".","type":"text"}]},{"type":"heading","level":2,"anchor":"Show-billing-problems","text":"Show billing problems"},{"type":"paragraph","inlineContent":[{"text":"When a renewal payment fails, the App Store retries it for up to 60 days. If you enabled","type":"text"},{"text":" ","type":"text"},{"text":"Billing Grace Period in App Store Connect, the customer keeps access for the first part of","type":"text"},{"text":" ","type":"text"},{"text":"that window.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["switch status.state {","case .inGracePeriod:","    \/\/ Still has access. Ask them to fix the payment method before it ends.","    showBanner(\"Update your payment method to keep Premium\",","               until: status.gracePeriodExpirationDate)","case .inBillingRetryPeriod:","    \/\/ Access is gone, but the subscription can still recover.","    showBanner(\"Your payment did not go through\")","default:","    break","}"]},{"type":"paragraph","inlineContent":[{"text":"On iOS and visionOS, send the customer to the system’s subscription screen with the manager’s","type":"text"},{"text":" ","type":"text"},{"code":"showManageSubscriptions(in:groupID:)","type":"codeVoice"},{"text":", passing the window scene that presents it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreSubscriptionStatus\/expirationReason-swift.property","type":"reference","isActive":true},{"text":" says why an expired subscription ended - turned off","type":"text"},{"text":" ","type":"text"},{"text":"by the customer, a billing error, a declined price increase, or a product no longer sold - so","type":"text"},{"text":" ","type":"text"},{"text":"the win-back message can match the reason.","type":"text"}]},{"type":"heading","level":2,"anchor":"Check-introductory-offer-eligibility","text":"Check introductory-offer eligibility"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreProduct\/introductoryOffer"},{"type":"text","text":" describes the trial or intro price that is configured; it"},{"type":"text","text":" "},{"type":"text","text":"does not say whether this customer may have it. A customer who has already redeemed an"},{"type":"text","text":" "},{"type":"text","text":"introductory offer in the group is not eligible again:"}]},{"type":"codeListing","syntax":"swift","code":["let eligible = await PurchasesManager.shared.isEligibleForIntroOffer(inGroup: groupID)","","if eligible, let intro = product.introductoryOffer, intro.paymentMode == .freeTrial {","    buyButton.title = \"Start free trial\"","} else {","    buyButton.title = \"Subscribe for \\(product.displayPrice)\"","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your server decides eligibility itself - for example, one trial per account across"},{"type":"text","text":" "},{"type":"text","text":"devices and Apple IDs - it can sign that decision. Pass the signed value in"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchaseOptions\/introductoryOfferEligibilityJWS"},{"type":"text","text":" and the App Store applies it instead of its"},{"type":"text","text":" "},{"type":"text","text":"own check."}]},{"type":"heading","level":2,"anchor":"Sell-a-promotional-offer","text":"Sell a promotional offer"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Promotional offers are for existing or lapsed subscribers, and each purchase needs a signature"},{"type":"text","text":" "},{"type":"text","text":"that only your server can produce. The app never holds the In-App Purchase key:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The app asks your server for a signature for the offer it wants to present, sending","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/SubscriptionOffer\/id","type":"reference","isActive":true},{"type":"text","text":" and the product ID."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The server checks the customer may have the offer and signs a compact JWS with your"},{"type":"text","text":" "},{"type":"text","text":"In-App Purchase key, using the App Store Server Library."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The app passes the JWS in "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchaseOptions\/promotionalOffer-swift.property","type":"reference","isActive":true},{"text":".","type":"text"}]}]}]},{"code":["guard let offer = product.promotionalOffers.first, let offerID = offer.id else { return }","","let jws = try await api.signPromotionalOffer(offerID: offerID, productID: product.productID)","let options = PurchaseOptions(","    appAccountToken: user.id,","    promotionalOffer: PurchaseOptions.PromotionalOffer(offerID: offerID, compactJWS: jws)",")","let (_, transaction) = try await PurchasesManager.shared","    .purchase(productID: product.productID, options: options)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A rejected offer throws "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesError\/Code-swift.struct\/ineligibleForOffer","type":"reference","isActive":true},{"text":" or ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesError\/Code-swift.struct\/invalidOffer","type":"reference","isActive":true},{"text":".","type":"text"}]},{"type":"heading","text":"Win back lapsed subscribers","anchor":"Win-back-lapsed-subscribers","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Win-back offers are configured in App Store Connect for customers whose subscription has"},{"type":"text","text":" "},{"type":"text","text":"ended. StoreKit decides eligibility itself, and "},{"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreProduct\/winBackOffers","isActive":true},{"type":"text","text":" lists only the"},{"type":"text","text":" "},{"type":"text","text":"offers this customer can redeem right now. Unlike promotional offers, they need no signature:"}]},{"type":"codeListing","code":["let product = try await PurchasesManager.shared","    .requestProducts(includingCache: false)","    .first { $0.productID == \"com.myapp.sub.premium.monthly\" }","","if let product, let offer = product.winBackOffers.first, let offerID = offer.id {","    let options = PurchaseOptions(winBackOfferID: offerID)","    _ = try await PurchasesManager.shared.purchase(productID: product.productID, options: options)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Fetch with "},{"type":"codeVoice","code":"includingCache: false"},{"type":"text","text":" before showing a win-back screen: eligibility is evaluated"},{"type":"text","text":" "},{"type":"text","text":"when StoreKit returns the product, and a cached product can be stale. An ID the product does"},{"type":"text","text":" "},{"type":"text","text":"not offer throws "},{"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesError\/Code-swift.struct\/offerNotFound","isActive":true},{"type":"text","text":" before the purchase sheet appears."}]},{"type":"heading","text":"Observe status changes","anchor":"Observe-status-changes","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Renewals, expirations, billing failures and plan changes happen while the app is not running"},{"type":"text","text":" "},{"type":"text","text":"a purchase. "},{"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/subscriptionStatusUpdates","isActive":true},{"type":"text","text":" delivers each new status:"}]},{"type":"codeListing","syntax":"swift","code":["Task {","    for await status in PurchasesManager.shared.subscriptionStatusUpdates {","        await MainActor.run { model.apply(status) }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Like "},{"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/purchasedProducts","isActive":true},{"type":"text","text":", every access returns a fresh stream and events"},{"type":"text","text":" "},{"type":"text","text":"are not replayed, so read the current state with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol\/subscriptionStatus(inGroup:)","isActive":true},{"type":"text","text":" when a subscriber starts."}]},{"type":"heading","text":"Verify on your server","anchor":"Verify-on-your-server","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Decisions with money attached belong on a server. "},{"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreSubscriptionStatus\/renewalInfoJWS","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreTransaction\/jwsRepresentation","isActive":true},{"type":"text","text":" are the App Store’s signed forms; send those rather"},{"type":"text","text":" "},{"type":"text","text":"than the decoded fields, which only say what the device read."}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/Subscriptions"},"references":{"doc://purchasekit.RKPurchaseKit/documentation/RKPurchaseKit/StoreSubscriptionStatus/expirationReason-swift.property":{"title":"expirationReason","abstract":[{"text":"Why the subscription expired or will expire, if it did or will.","type":"text"}],"role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"expirationReason","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:13RKPurchaseKit23StoreSubscriptionStatusV16ExpirationReasonV","text":"ExpirationReason","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreSubscriptionStatus\/expirationReason-swift.property","type":"topic","url":"\/documentation\/rkpurchasekit\/storesubscriptionstatus\/expirationreason-swift.property"},"doc://purchasekit.RKPurchaseKit/documentation/RKPurchaseKit/StoreSubscriptionStatus/transaction":{"role":"sym