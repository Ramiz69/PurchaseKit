 bought with: an introductory, promotional or","type":"text"},{"text":" ","type":"text"},{"text":"win-back offer.","type":"text"}],"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/SubscriptionOffer","role":"symbol","type":"topic","kind":"symbol","title":"SubscriptionOffer","url":"\/documentation\/rkpurchasekit\/subscriptionoffer","navigatorTitle":[{"kind":"identifier","text":"SubscriptionOffer"}]},"doc://purchasekit.RKPurchaseKit/documentation/RKPurchaseKit/PurchaseOptions/winBackOfferID":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"winBackOfferID"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?"}],"abstract":[{"type":"text","text":"The identifier of one of the product’s "},{"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreProduct\/winBackOffers","isActive":true},{"type":"text","text":" to apply."}],"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchaseOptions\/winBackOfferID","role":"symbol","type":"topic","kind":"symbol","title":"winBackOfferID","url":"\/documentation\/rkpurchasekit\/purchaseoptions\/winbackofferid"},"doc://purchasekit.RKPurchaseKit/documentation/RKPurchaseKit/StoreTransaction/productID":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"productID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"abstract":[{"text":"The product this transaction is for.","type":"text"}],"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreTransaction\/productID","role":"symbol","type":"topic","kind":"symbol","title":"productID","url":"\/documentation\/rkpurchasekit\/storetransaction\/productid"},"doc://purchasekit.RKPurchaseKit/documentation/RKPurchaseKit/PurchaseOptions":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PurchaseOptions"}],"abstract":[{"type":"text","text":"Everything a purchase can carry besides the product: an account token, a quantity, an"},{"type":"text","text":" "},{"type":"text","text":"offer, and sandbox switches."}],"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchaseOptions","role":"symbol","kind":"symbol","type":"topic","title":"PurchaseOptions","url":"\/documentation\/rkpurchasekit\/purchaseoptions","navigatorTitle":[{"kind":"identifier","text":"PurchaseOptions"}]},"doc://purchasekit.RKPurchaseKit/documentation/RKPurchaseKit/SubscriptionOffer/id":{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/SubscriptionOffer\/id","title":"id","abstract":[{"text":"The offer identifier from App Store Connect. ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" for an introductory offer, which","type":"text"},{"text":" ","type":"text"},{"text":"has none.","type":"text"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?"}],"role":"symbol","kind":"symbol","url":"\/documentation\/rkpurchasekit\/subscriptionoffer\/id","type":"topic"},"doc://purchasekit.RKPurchaseKit/documentation/RKPurchaseKit/StoreTransaction/jwsRepresentation":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"jwsRepresentation"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?"}],"abstract":[{"type":"text","text":"The transaction as the App Store signed it: a JWS your server can verify with the App"},{"type":"text","text":" "},{"type":"text","text":"Store Server Library before it grants anything."}],"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/d