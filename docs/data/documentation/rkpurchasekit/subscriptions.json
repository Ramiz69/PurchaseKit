{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/Subscriptions"},"hierarchy":{"paths":[["doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit"]]},"abstract":[{"type":"text","text":"Read renewal state, react to billing problems, and sell introductory, promotional and"},{"type":"text","text":" "},{"type":"text","text":"win-back offers."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An entitlement check answers one question: may the customer use the feature right now? A"},{"type":"text","text":" "},{"type":"text","text":"subscription app usually needs more - whether the subscription will renew, whether a payment"},{"type":"text","text":" "},{"type":"text","text":"is failing, which offer this customer may see. "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreSubscriptionStatus","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/SubscriptionOffer","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"and "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchaseOptions","type":"reference","isActive":true},{"type":"text","text":" cover that ground."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The examples use one subscription group:"}]},{"type":"codeListing","syntax":"swift","code":["let groupID = \"com.myapp.subscriptions.premium\""]},{"inlineContent":[{"type":"text","text":"The group ID is configured in App Store Connect and available as"},{"text":" ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreProduct\/subscriptionGroupID","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Read-the-subscription-status","level":2,"type":"heading","text":"Read the subscription status"},{"inlineContent":[{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol\/subscriptionStatus(inGroup:)","isActive":true,"type":"reference"},{"text":" returns the status that matters most for a","type":"text"},{"text":" ","type":"text"},{"text":"group, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when the customer has never subscribed to it:","type":"text"}],"type":"paragraph"},{"code":["let status = try await PurchasesManager.shared.subscriptionStatus(inGroup: groupID)","","if let status {","    print(status.state.rawValue, status.isActive)","    print(\"Renews:\", status.willAutoRenew, \"on\", status.renewalDate ?? .distantPast)","    print(\"Into:\", status.autoRenewProductID ?? \"-\")","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreSubscriptionStatus\/isActive","isActive":true,"type":"reference"},{"text":" follows the App Store’s rule for access: subscribed or in a","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"grace period. "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreSubscriptionStatus\/transaction","isActive":true,"type":"reference"},{"text":" is the latest transaction behind the status,","type":"text"},{"text":" ","type":"text"},{"text":"so its ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreTransaction\/expirationDate","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreTransaction\/offer-swift.property","isActive":true,"type":"reference"},{"type":"text","text":" describe the current"},{"text":" ","type":"text"},{"type":"text","text":"period."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreSubscriptionStatus\/autoRenewProductID","isActive":true,"type":"reference"},{"type":"text","text":" differs from the transaction’s"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreTransaction\/productID"},{"type":"text","text":", the customer has scheduled an upgrade, downgrade or"},{"type":"text","text":" "},{"type":"text","text":"crossgrade that takes effect at the next renewal."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"With Family Sharing a customer can hold more than one status in a group. Read them all with"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/subscriptionStatuses(inGroup:)"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"text":"Show billing problems","anchor":"Show-billing-problems","type":"heading"},{"inlineContent":[{"type":"text","text":"When a renewal payment fails, the App Store retries it for up to 60 days. If you enabled"},{"type":"text","text":" "},{"type":"text","text":"Billing Grace Period in App Store Connect, the customer keeps access for the first part of"},{"type":"text","text":" "},{"type":"text","text":"that window."}],"type":"paragraph"},{"code":["switch status.state {","case .inGracePeriod:","    \/\/ Still has access. Ask them to fix the payment method before it ends.","    showBanner(\"Update your payment method to keep Premium\",","               until: status.gracePeriodExpirationDate)","case .inBillingRetryPeriod:","    \/\/ Access is gone, but the subscription can still recover.","    showBanner(\"Your payment did not go through\")","default:","    break","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"On iOS and visionOS, send the customer to the system’s subscription screen with the manager’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"showManageSubscriptions(in:groupID:)"},{"type":"text","text":", passing the window scene that presents it."}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreSubscriptionStatus\/expirationReason-swift.property"},{"type":"text","text":" says why an expired subscription ended - turned off"},{"type":"text","text":" "},{"type":"text","text":"by the customer, a billing error, a declined price increase, or a product no longer sold - so"},{"type":"text","text":" "},{"type":"text","text":"the win-back message can match the reason."}],"type":"paragraph"},{"level":2,"text":"Check introductory-offer eligibility","anchor":"Check-introductory-offer-eligibility","type":"heading"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreProduct\/introductoryOffer"},{"type":"text","text":" describes the trial or intro price that is configured; it"},{"type":"text","text":" "},{"type":"text","text":"does not say whether this customer may have it. A customer who has already redeemed an"},{"type":"text","text":" "},{"type":"text","text":"introductory offer in the group is not eligible again:"}],"type":"paragraph"},{"code":["let eligible = await PurchasesManager.shared.isEligibleForIntroOffer(inGroup: groupID)","","if eligible, let intro = product.introductoryOffer, intro.paymentMode == .freeTrial {","    buyButton.title = \"Start free trial\"","} else {","    buyButton.title = \"Subscribe for \\(product.displayPrice)\"","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"If your server decides eligibility itself - for example, one trial per account across"},{"type":"text","text":" "},{"type":"text","text":"devices and Apple IDs - it can sign that decision. Pass the signed value in"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchaseOptions\/introductoryOfferEligibilityJWS"},{"type":"text","text":" and the App Store applies it instead of its"},{"type":"text","text":" "},{"type":"text","text":"own check."}],"type":"paragraph"},{"level":2,"text":"Sell a promotional offer","anchor":"Sell-a-promotional-offer","type":"heading"},{"inlineContent":[{"type":"text","text":"Promotional offers are for existing or lapsed subscribers, and each purchase needs a signature"},{"type":"text","text":" "},{"type":"text","text":"that only your server can produce. The app never holds the In-App Purchase key:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The app asks your server for a signature for the offer it wants to present, sending"},{"type":"text","text":" "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/SubscriptionOffer\/id","isActive":true,"type":"reference"},{"type":"text","text":" and the product ID."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The server checks the customer may have the offer and signs a compact JWS with your"},{"type":"text","text":" "},{"type":"text","text":"In-App Purchase key, using the App Store Server Library."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The app passes the JWS in "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchaseOptions\/promotionalOffer-swift.property","isActive":true,"type":"reference"},{"type":"text","text":"."}]}]}],"type":"orderedList"},{"code":["guard let offer = product.promotionalOffers.first, let offerID = offer.id else { return }","","let jws = try await api.signPromotionalOffer(offerID: offerID, productID: product.productID)","let options = PurchaseOptions(","    appAccountToken: user.id,","    promotionalOffer: PurchaseOptions.PromotionalOffer(offerID: offerID, compactJWS: jws)",")","let (_, transaction) = try await PurchasesManager.shared","    .purchase(productID: product.productID, options: options)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"A rejected offer throws "},{"isActive":true,"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesError\/Code-swift.struct\/ineligibleForOffer"},{"type":"text","text":" or "},{"isActive":true,"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesError\/Code-swift.struct\/invalidOffer"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"text":"Win back lapsed subscribers","anchor":"Win-back-lapsed-subscribers","type":"heading"},{"inlineContent":[{"type":"text","text":"Win-back offers are configured in App Store Connect for customers whose subscription has"},{"type":"text","text":" "},{"type":"text","text":"ended. StoreKit decides eligibility itself, and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreProduct\/winBackOffers"},{"type":"text","text":" lists only the"},{"type":"text","text":" "},{"type":"text","text":"offers this customer can redeem right now. Unlike promotional offers, they need no signature:"}],"type":"paragraph"},{"code":["let product = try await PurchasesManager.shared","    .requestProducts(includingCache: false)","    .first { $0.productID == \"com.myapp.sub.premium.monthly\" }","","if let product, let offer = product.winBackOffers.first, let offerID = offer.id {","    let options = PurchaseOptions(winBackOfferID: offerID)","    _ = try await PurchasesManager.shared.purchase(productID: product.productID, options: options)","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Fetch with "},{"type":"codeVoice","code":"includingCache: false"},{"type":"text","text":" before showing a win-back screen: eligibility is evaluated"},{"type":"text","text":" "},{"type":"text","text":"when StoreKit returns the product, and a cached product can be stale. An ID the product does"},{"type":"text","text":" "},{"type":"text","text":"not offer throws "},{"isActive":true,"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesError\/Code-swift.struct\/offerNotFound"},{"type":"text","text":" before the purchase sheet appears."}],"type":"paragraph"},{"level":2,"text":"Observe status changes","anchor":"Observe-status-changes","type":"heading"},{"inlineContent":[{"type":"text","text":"Renewals, expirations, billing failures and plan changes happen while the app is not running"},{"type":"text","text":" "},{"type":"text","text":"a purchase. "},{"isActive":true,"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/subscriptionStatusUpdates"},{"type":"text","text":" delivers each new status:"}],"type":"paragraph"},{"code":["Task {","    for await status in PurchasesManager.shared.subscriptionStatusUpdates {","        await MainActor.run { model.apply(status) }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Like "},{"isActive":true,"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/purchasedProducts"},{"type":"text","text":", every access returns a fresh stream and events"},{"type":"text","text":" "},{"type":"text","text":"are not replayed, so read the current state with"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol\/subscriptionStatus(inGroup:)"},{"type":"text","text":" when a subscriber starts."}],"type":"paragraph"},{"level":2,"text":"Verify on your server","anchor":"Verify-on-your-server","type":"heading"},{"inlineContent":[{"type":"text","text":"Decisions with money attached belong on a server. "},{"isActive":true,"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreSubscriptionStatus\/renewalInfoJWS"},{"type":"text","text":" and"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreTransaction\/jwsRepresentation"},{"type":"text","text":" are the App Store’s signed forms; send those rather"},{"type":"text","text":" "},{"type":"text","text":"than the decoded fields, which only say what the device read."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/rkpurchasekit\/subscriptions"]}],"metadata":{"roleHeading":"Article","role":"article","title":"Subscriptions","modules":[{"name":"PurchaseKit"}]},"kind":"article","sections":[],"references":{"doc://purchasekit.RKPurchaseKit/documentation/RKPurchaseKit/PurchaseOptions/promotionalOffer-swift.property":{"type":"topic","kind":"symbol","url":"\/documentation\/rkpurchasekit\/purchaseoptions\/promotionaloffer-swift.property","abstract":[{"type":"text","text":"A server-signed promotional offer to apply."}],"role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"promotionalOffer"},{"kind":"text","text":": "},{"preciseIdentifier":"s:13RKPurchaseKit15PurchaseOptionsV16PromotionalOfferV","kind":"typeIdentifier","text":"PromotionalOffer"},{"kind":"text","text":"?"}],"title":"promotionalOffer","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchaseOptions\/promotionalOffer-swift.property"},"doc://purchasekit.RKPurchaseKit/documentation/RKPurchaseKit/SubscriptionOffer":{"title":"SubscriptionOffer","url":"\/documentation\/rkpurchasekit\/subscriptionoffer","abstract":[{"type":"text","text":"A discount a subscription product can be bought with: an introductory, promotional or"},{"type":"text","text":" "},{"type":"text","text":"win-back offer."}],"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/SubscriptionOffer","role":"symbol","navigatorTitle":[{"text":"SubscriptionOffer","kind":"identifier"}],"kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SubscriptionOffer","kind":"identifier"}]},"doc://purchasekit.RKPurchaseKit/documentation/RKPurchaseKit/StoreTransaction/productID":{"title":"productID","url":"\/documentation\/rkpurchasekit\/storetransaction\/productid","abstract":[{"type":"text","text":"The product this transaction is for."}],"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreTransaction\/productID","role":"symbol","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"productID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}]},"doc://purchasekit.RKPurchaseKit/documentation/RKPurchaseKit/PurchasesManager/subscriptionStatuses(inGroup:)":{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/subscriptionStatuses(inGroup:)","url":"\/documentation\/rkpurchasekit\/purchasesmanager\/subscriptionstatuses(ingroup:)","abstract":[{"type":"text","text":"Returns every renewal status StoreKit holds for a subscription group."}],"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"subscriptionStatuses"},{"kind":"text","text":"("},{"kind":"externalParam","text":"inGroup"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> ["},{"kind":"typeIdentifier","preciseIdentifier":"s:13RKPurchaseKit23StoreSubscriptionStatusV","text":"StoreSubscriptionStatus"},{"kind":"text","text":"]"}],"role":"symbol","title":"subscriptionStatuses(inGroup:)"},"doc://purchasekit.RKPurchaseKit/documentation/RKPurchaseKit/StoreProduct/subscriptionGroupID":{"kind":"symbol","abstract":[{"text":"Subscription group identifier for auto-renewable subscriptions.","type":"text"}],"title":"subscriptionGroupID","type":"topic","url":"\/documentation\/rkpurchasekit\/storeproduct\/subscriptiongroupid","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"subscriptionGroupID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreProduct\/subscriptionGroupID"},"doc://purchasekit.RKPurchaseKit/documentation/RKPurchaseKit/StoreSubscriptionStatus":{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreSubscriptionStatus","navigatorTitle":[{"kind":"identifier","text":"StoreSubscriptionStatus"}],"url":"\/documentation\/rkpurchasekit\/storesubscriptionstatus","abstract":[{"type":"text","text":"The renewal state of one subscription in a group, with what it will do next."}],"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"StoreSubscriptionStatus"}],"role":"symbol","title":"StoreSubscriptionStatus"},"doc://purchasekit.RKPurchaseKit/documentation/RKPurchaseKit/StoreProduct/introductoryOffer":{"kind":"symbol","abstract":[{"text":"The introductory offer configured for the subscription, if any.","type":"text"}],"role":"symbol","url":"\/documentation\/rkpurchasekit\/storeproduct\/introductoryoffer","title":"introductoryOffer","type":"topic","identi