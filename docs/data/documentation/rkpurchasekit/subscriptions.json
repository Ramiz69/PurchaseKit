{"metadata":{"modules":[{"name":"PurchaseKit"}],"roleHeading":"Article","title":"Subscriptions","role":"article"},"abstract":[{"type":"text","text":"Read renewal state, react to billing problems, and sell introductory, promotional and"},{"type":"text","text":" "},{"type":"text","text":"win-back offers."}],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"An entitlement check answers one question: may the customer use the feature right now? A"},{"type":"text","text":" "},{"type":"text","text":"subscription app usually needs more - whether the subscription will renew, whether a payment"},{"type":"text","text":" "},{"type":"text","text":"is failing, which offer this customer may see. "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreSubscriptionStatus","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/SubscriptionOffer","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchaseOptions"},{"type":"text","text":" cover that ground."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The examples use one subscription group:"}],"type":"paragraph"},{"syntax":"swift","code":["let groupID = \"com.myapp.subscriptions.premium\""],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The group ID is configured in App Store Connect and available as"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreProduct\/subscriptionGroupID","isActive":true},{"type":"text","text":"."}]},{"level":2,"type":"heading","anchor":"Read-the-subscription-status","text":"Read the subscription status"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol\/subscriptionStatus(inGroup:)","isActive":true},{"type":"text","text":" returns the status that matters most for a"},{"type":"text","text":" "},{"type":"text","text":"group, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" when the customer has never subscribed to it:"}]},{"type":"codeListing","code":["let status = try await PurchasesManager.shared.subscriptionStatus(inGroup: groupID)","","if let status {","    print(status.state.rawValue, status.isActive)","    print(\"Renews:\", status.willAutoRenew, \"on\", status.renewalDate ?? .distantPast)","    print(\"Into:\", status.autoRenewProductID ?? \"-\")","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreSubscriptionStatus\/isActive","isActive":true},{"type":"text","text":" follows the App Store’s rule for access: subscribed or in a"},{"type":"text","text":" "},{"type":"text","text":"grace period. "},{"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreSubscriptionStatus\/transaction","isActive":true},{"text":" is the latest transaction behind the status,","type":"text"},{"text":" ","type":"text"},{"text":"so its ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreTransaction\/expirationDate","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreTransaction\/offer-swift.property","isActive":true,"type":"reference"},{"text":" describe the current","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"period."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"isActive":true,"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreSubscriptionStatus\/autoRenewProductID"},{"type":"text","text":" differs from the transaction’s"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreTransaction\/productID"},{"type":"text","text":", the customer has scheduled an upgrade, downgrade or"},{"type":"text","text":" "},{"type":"text","text":"crossgrade that takes effect at the next renewal."}]},{"type":"paragraph","inlineContent":[{"text":"With Family Sharing a customer can hold more than one status in a group. Read them all with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/subscriptionStatuses(inGroup:)","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"level":2,"type":"heading","anchor":"Show-billing-problems","text":"Show billing problems"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When a renewal payment fails, the App Store retries it for up to 60 days. If you enabled"},{"type":"text","text":" "},{"type":"text","text":"Billing Grace Period in App Store Connect, the customer keeps access for the first part of"},{"type":"text","text":" "},{"type":"text","text":"that window."}]},{"type":"codeListing","code":["switch status.state {","case .inGracePeriod:","    \/\/ Still has access. Ask them to fix the payment method before it ends.","    showBanner(\"Update your payment method to keep Premium\",","               until: status.gracePeriodExpirationDate)","case .inBillingRetryPeriod:","    \/\/ Access is gone, but the subscription can still recover.","    showBanner(\"Your payment did not go through\")","default:","    break","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"On iOS and visionOS, send the customer to the system’s subscription screen with the manager’s","type":"text"},{"text":" ","type":"text"},{"code":"showManageSubscriptions(in:groupID:)","type":"codeVoice"},{"text":", passing the window scene that presents it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreSubscriptionStatus\/expirationReason-swift.property","isActive":true},{"type":"text","text":" says why an expired subscription ended - turned off"},{"type":"text","text":" "},{"type":"text","text":"by the customer, a billing error, a declined price increase, or a product no longer sold - so"},{"type":"text","text":" "},{"type":"text","text":"the win-back message can match the reason."}]},{"level":2,"anchor":"Check-introductory-offer-eligibility","type":"heading","text":"Check introductory-offer eligibility"},{"inlineContent":[{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreProduct\/introductoryOffer","type":"reference","isActive":true},{"type":"text","text":" describes the trial or intro price that is configured; it"},{"type":"text","text":" "},{"type":"text","text":"does not say whether this customer may have it. A customer who has already redeemed an"},{"type":"text","text":" "},{"type":"text","text":"introductory offer in the group is not eligible again:"}],"type":"paragraph"},{"code":["let eligible = await PurchasesManager.shared.isEligibleForIntroOffer(inGroup: groupID)","","if eligible, let intro = product.introductoryOffer, intro.paymentMode == .freeTrial {","    buyButton.title = \"Start free trial\"","} else {","    buyButton.title = \"Subscribe for \\(product.displayPrice)\"","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"If your server decides eligibility itself - for example, one trial per account across"},{"text":" ","type":"text"},{"text":"devices and Apple IDs - it can sign that decision. Pass the signed value in","type":"text"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchaseOptions\/introductoryOfferEligibilityJWS"},{"type":"text","text":" and the App Store applies it instead of its"},{"type":"text","text":" "},{"type":"text","text":"own check."}],"type":"paragraph"},{"level":2,"anchor":"Sell-a-promotional-offer","type":"heading","text":"Sell a promotional offer"},{"inlineContent":[{"type":"text","text":"Promotional offers are for existing or lapsed subscribers, and each purchase needs a signature"},{"type":"text","text":" "},{"type":"text","text":"that only your server can produce. The app never holds the In-App Purchase key:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The app asks your server for a signature for the offer it wants to present, sending"},{"type":"text","text":" "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/SubscriptionOffer\/id","type":"reference","isActive":true},{"type":"text","text":" and the product ID."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The server checks the customer may have the offer and signs a compact JWS with your"},{"type":"text","text":" "},{"type":"text","text":"In-App Purchase key, using the App Store Server Library."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The app passes the JWS in "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchaseOptions\/promotionalOffer-swift.property","type":"reference","isActive":true},{"type":"text","text":"."}]}]}],"type":"orderedList"},{"code":["guard let offer = product.promotionalOffers.first, let offerID = offer.id else { return }","","let jws = try await api.signPromotionalOffer(offerID: offerID, productID: product.productID)","let options = PurchaseOptions(","    appAccountToken: user.id,","    promotionalOffer: PurchaseOptions.PromotionalOffer(offerID: offerID, compactJWS: jws)",")","let (_, transaction) = try await PurchasesManager.shared","    .purchase(productID: product.productID, options: options)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"A rejected offer throws ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesError\/Code-swift.struct\/ineligibleForOffer","isActive":true,"type":"reference"},{"text":" or ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesError\/Code-swift.struct\/invalidOffer","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Win-back-lapsed-subscribers","type":"heading","text":"Win back lapsed subscribers"},{"inlineContent":[{"text":"Win-back offers are configured in App Store Connect for customers whose subscription has","type":"text"},{"text":" ","type":"text"},{"text":"ended. StoreKit decides eligibility itself, and ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreProduct\/winBackOffers","isActive":true,"type":"reference"},{"text":" lists only the","type":"text"},{"text":" ","type":"text"},{"text":"offers this customer can redeem right now. Unlike promotional offers, they need no signature:","type":"text"}],"type":"paragraph"},{"code":["let product = try await PurchasesManager.shared","    .requestProducts(includingCache: false)","    .first { $0.productID == \"com.myapp.sub.premium.monthly\" }","","if let product, let offer = product.winBackOffers.first, let offerID = offer.id {","    let options = PurchaseOptions(winBackOfferID: offerID)","    _ = try await PurchasesManager.shared.purchase(productID: product.productID, options: options)","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Fetch with ","type":"text"},{"code":"includingCache: false","type":"codeVoice"},{"text":" before showing a win-back screen: eligibility is evaluated","type":"text"},{"text