{"abstract":[{"text":"Read renewal state, react to billing problems, and sell introductory, promotional and","type":"text"},{"text":" ","type":"text"},{"text":"win-back offers.","type":"text"}],"identifier":{"url":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/Subscriptions","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"role":"article","modules":[{"name":"PurchaseKit"}],"roleHeading":"Article","title":"Subscriptions"},"kind":"article","sections":[],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An entitlement check answers one question: may the customer use the feature right now? A"},{"type":"text","text":" "},{"type":"text","text":"subscription app usually needs more - whether the subscription will renew, whether a payment"},{"type":"text","text":" "},{"type":"text","text":"is failing, which offer this customer may see. "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreSubscriptionStatus","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/SubscriptionOffer","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"and "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchaseOptions","type":"reference","isActive":true},{"type":"text","text":" cover that ground."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The examples use one subscription group:"}]},{"syntax":"swift","type":"codeListing","code":["let groupID = \"com.myapp.subscriptions.premium\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The group ID is configured in App Store Connect and available as"},{"type":"text","text":" "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreProduct\/subscriptionGroupID","type":"reference","isActive":true},{"type":"text","text":"."}]},{"level":2,"text":"Read the subscription status","anchor":"Read-the-subscription-status","type":"heading"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol\/subscriptionStatus(inGroup:)","type":"reference","isActive":true},{"type":"text","text":" returns the status that matters most for a"},{"type":"text","text":" "},{"type":"text","text":"group, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when the customer has never subscribed to it:"}]},{"syntax":"swift","type":"codeListing","code":["let status = try await PurchasesManager.shared.subscriptionStatus(inGroup: groupID)","","if let status {","    print(status.state.rawValue, status.isActive)","    print(\"Renews:\", status.willAutoRenew, \"on\", status.renewalDate ?? .distantPast)","    print(\"Into:\", status.autoRenewProductID ?? \"-\")","}"]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreSubscriptionStatus\/isActive","type":"reference","isActive":true},{"type":"text","text":" follows the App Store’s rule for access: subscribed or in a"},{"type":"text","text":" "},{"type":"text","text":"grace period. "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreSubscriptionStatus\/transaction","type":"reference","isActive":true},{"type":"text","text":" is the latest transaction behind the status,"},{"type":"text","text":" "},{"type":"text","text":"so its "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreTransaction\/expirationDate","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreTransaction\/offer-swift.property","type":"reference","isActive":true},{"type":"text","text":" describe the current"},{"type":"text","text":" "},{"type":"text","text":"period."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreSubscriptionStatus\/autoRenewProductID","type":"reference","isActive":true},{"type":"text","text":" differs from the transaction’s"},{"type":"text","text":" "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreTransaction\/productID","type":"reference","isActive":true},{"type":"text","text":", the customer has scheduled an upgrade, downgrade or"},{"type":"text","text":" "},{"type":"text","text":"crossgrade that takes effect at the next renewal."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"With Family Sharing a customer can hold more than one status in a group. Read them all with"},{"type":"text","text":" "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/subscriptionStatuses(inGroup:)","type":"reference","isActive":true},{"type":"text","text":"."}]},{"level":2,"text":"Show billing problems","anchor":"Show-billing-problems","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When a renewal payment fails, the App Store retries it for up to 60 days. If you enabled"},{"type":"text","text":" "},{"type":"text","text":"Billing Grace Period in App Store Connect, the customer keeps access for the first part of"},{"type":"text","text":" "},{"type":"text","text":"that window."}]},{"syntax":"swift","type":"codeListing","code":["switch status.state {","case .inGracePeriod:","    \/\/ Still has access. Ask them to fix the payment method before it ends.","    showBanner(\"Update your payment method to keep Premium\",","               until: status.gracePeriodExpirationDate)","case .inBillingRetryPeriod:","    \/\/ Access is gone, but the subscription can still recover.","    showBanner(\"Your payment did not go through\")","default:","    break","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On iOS and visionOS, send the customer to the system’s subscription screen with the manager’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"showManageSubscriptions(in:groupID:)"},{"type":"text","text":", passing the window scene that presents it."}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreSubscriptionStatus\/expirationReason-swift.property","type":"reference","isActive":true},{"type":"text","text":" says why an expired subscription ended - turned off"},{"type":"text","text":" "},{"type":"text","text":"by the customer, a billing error, a declined price increase, or a product no longer sold - so"},{"type":"text","text":" "},{"type":"text","text":"the win-back message can match the reason."}]},{"level":2,"text":"Check introductory-offer eligibility","anchor":"Check-introductory-offer-eligibility","type":"heading"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreProduct\/introductoryOffer","type":"reference","isActive":true},{"type":"text","text":" describes the trial or intro price that is configured; it"},{"type":"text","text":" "},{"type":"text","text":"does not say whether this customer may have it. A customer who has already redeemed an"},{"type":"text","text":" "},{"type":"text","text":"introductory offer in the group is not eligible again:"}]},{"syntax":"swift","type":"codeListing","code":["let eligible = await PurchasesManager.shared.isEligibleForIntroOffer(inGroup: groupID)","","if eligible, let intro = product.introductoryOffer, intro.paymentMode == .freeTrial {","    buyButton.title = \"Start free trial\"","} else {","    buyButton.title = \"Subscribe for \\(product.displayPrice)\"","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your server decides eligibility itself - for example, one trial per account across"},{"type":"text","text":" "},{"type":"text","text":"devices and Apple IDs - it can sign that decision. Pass the signed value in"},{"type":"text","text":" "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchaseOptions\/introductoryOfferEligibilityJWS","type":"reference","isActive":true},{"type":"text","text":" and the App Store applies it instead of its"},{"type":"text","text":" "},{"type":"text","text":"own check."}]},{"level":2,"text":"Sell a promotional offer","anchor":"Sell-a-promotional-offer","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Promotional offers are for existing or lapsed subscribers, and each purchase needs a signature"},{"type":"text","text":" "},{"type":"text","text":"that only your server can produce. The app never holds the In-App Purchase key:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The app asks your server for a signature for the offer it wants to present, sending"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/SubscriptionOffer\/id","isActive":true},{"type":"text","text":" and the product ID."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The server checks the customer may have the offer and signs a compact JWS with your"},{"type":"text","text":" "},{"type":"text","text":"In-App Purchase key, using the App Store Server Library."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The app passes the JWS in "},{"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchaseOptions\/promotionalOffer-swift.property","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"syntax":"swift","type":"codeListing","code":["guard let offer = product.promotionalOffers.first, let offerID = offer.id else { return }","","let jws = try await api.signPromotionalOffer(offerID: offerID, productID: product.productID)","let options = PurchaseOptions(","    appAccountToken: user.id,","    promotionalOffer: PurchaseOptions.PromotionalOffer(offerID: offerID, compactJWS: jws)",")","let (_, transaction) = try await PurchasesManager.shared","    .purchase(productID: product.productID, options: options)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A rejected offer throws "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesError\/Code-swift.struct\/ineligibleForOffer","type":"reference","isActive":true},{"type":"text","text":" or "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesError\/Code-swift.struct\/invalidOffer","type":"reference","isActive":true},{"type":"text","text":"."}]},{"level":2,"text":"Win back lapsed subscribers","anchor":"Win-back-lapsed-subscribers","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Win-back offers are configured in App Store Connect for customers whose subscription has"},{"type":"text","text":" "},{"type":"text","text":"ended. StoreKit decides eligibility itself, and "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreProduct\/winBackOffers","type":"reference","isActive":true},{"type":"text","text":" lists only the"},{"type":"text","text":" "},{"type":"text","text":"offers this customer can redeem right now. Unlike promotional offers, they need no signature:"}]},{"syntax":"swift","type":"codeListing","code":["let product = try await PurchasesManager.shared","    .requestProducts(includingCache: false)","    .first { $0.productID == \"com.myapp.sub.premium.monthly\" }","","if let product, let offer = product.winBackOffers.first, let offerID = offer.id {","    let options = PurchaseOptions(winBackOfferID: offerID)","    _ = try await PurchasesManager.shared.purchase(productID: product.productID, options: options)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Fetch with "},{"type":"codeVoice","code":"includingCache: false"},{"type":"text","text":" before showing a win-back screen: eligibility is evaluated"},{"type":"text","text":" "},{"type":"text","text":"when StoreKit returns the product, and a cached product can be stale. An ID the product does"},{"type":"text","text":" "},{"type":"text","text":"not offer throws "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesError\/Code-swift.struct\/offerNotFound","type":"reference","isActive":true},{"type":"text","text":" before the purchase sheet appears."}]},{"level":2,"text":"Observe status changes","anchor":"Observe-status-changes","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Renewals, expirations, billing failures and plan changes happen while the app is not running"},{"type":"text","text":" "},{"type":"text","text":"a purchase. "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/subscriptionStatusUpdates","type":"reference","isActive":true},{"type":"text","text":" delivers each new status:"}]},{"syntax":"swift","type":"codeListing","code":["Task {","    for await status in PurchasesManager.shared.subscriptionStatusUpdates {","        await MainActor.run { model.apply(status) }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Like "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/purchasedProducts","type":"reference","isActive":true},{"type":"text","text":", every access returns a fresh stream and events"},{"type":"text","text":" "},{"type":"text","text":"are not replayed, so read the current state with"},{"type":"text","text":" "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol\/subscriptionStatus(inGroup:)","type":"reference","isActive":true},{"type":"text","text":" when a subscriber starts."}]},{"level":2,"text":"Verify on your server","anchor":"Verify-on-your-server","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Decisions with money attached belong on a server. "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreSubscriptionStatus\/renewalInfoJWS","type":"reference","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreTransaction\/jwsRepresentation","type":"reference","isActive":true},{"type":"text","text":" are the App Store’s signed forms; send those rather"},{"type":"text","text":" "},{"type":"text","text":"than the decoded fields, which only say what the device read."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/rkpurchasekit\/subscriptions"]}],"references":{"doc://purchasekit.RKPurchaseKit/documentation/RKPurchaseKit/StoreTransaction/offer-swift.property":{"kind":"symbol","abstract":[{"text":"The subscription offer the transaction was bought with, if any.","type":"text"}],"title":"offer","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"offer","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:13RKPurchaseKit16StoreTransactionV5OfferV","text":"Offer","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"role":"symbol","type":"topic","url":"\/documentation\/rkpurchasekit\/storetransaction\/offer-swift.property","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreTransaction\/offer-swift.property"},"doc://purchasekit.RKPurchaseKit/documentation/RKPurchaseKit/PurchaseOptions/introductoryOfferEligibilityJWS":{"type":"topic","kind":"symbol","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchaseOptions\/introductoryOfferEligibilityJWS","url":"\/documentation\/rkpurchasekit\/purchaseoptions\/introductoryoffereligibilityjws","abstract":[{"type":"text","text":"A compact JWS from your server that overrides the App Store’s own introductory offer"},{"type":"text","text":" "},{"type":"text","text":"eligibility decision for this purchase."}],"title":"introductoryOfferEligibilityJWS","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"introductoryOfferEligibilityJWS","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?","kind":"text"}],"role":"symbol"},"doc://purchasekit.RKPurchaseKit/documentation/RKPurchaseKit/PurchasesProtocol/subscriptionStatus(inGroup:)":{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol\/subscriptionStatus(inGroup:)","title":"subscriptionStatus(inGroup:)","abstract":[{"type":"text","text":"Returns the status that best describes the customer’s access to a group, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" "},{"type":"text","text":"when the customer has never subscribed to it."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"subscriptionStatus"},{"kind":"text","text":"("},{"kind":"externalParam","text":"inGroup"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"StoreSubscriptionStatus","preciseIdentifier":"s:13RKPurchaseKit23StoreSubscriptionStatusV"},{"kind":"text","text":"?"}],"role":"symbol","kind":"symbol","url":"\/documentation\/rkpurchasekit\/purchasesprotocol\/subscriptionstatus(ingroup:)","type":"topic"},"doc://purchasekit.RKPurchaseKit/documentation/RKPurchaseKit/StoreProduct/winBackOffers":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"winBackOffers"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:13RKPurchaseKit17SubscriptionOfferV","kind":"typeIdentifier","text":"SubscriptionOffer"},{"kind":"text","text":"]"}],"abstract":[{"type":"text","text":"Win-back offers configured for the subscription, for customers whose subscription"},{"type":"text","text":" "},{"type":"text","text":"lapsed. Bought by identifier through "},{"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchaseOptions\/winBackOfferID","isActive":true},{"type":"text","text":"."}],"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreProduct\/winBackOffers","role":"symbol","type":"topic","kind":"symbol","title":"winBackOffers","url":"\/documentation\/rkpurchasekit\/storeproduct\/winbackoffers"},"doc://purchasekit.RKPurchaseKit/documentation/RKPurchaseKit/PurchasesManager/subscriptionStatusUpdates":{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/subscriptionStatusUpdates","title":"subscriptionStatusUpdates","abstract":[{"text":"Every renewal status StoreKit reports while the app runs: renewals, expirations,","type":"text"},{"text":" ","type":"text"},{"text":"billing failures, plan changes, refunds.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"subscriptionStatusUpdates"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"AsyncStream","preciseIdentifier":"s:ScS"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"StoreSubscriptionStatus","preciseIdentifier":"s:13RKPurchaseKit23StoreSubscriptionStatusV"},{"kind":"text","text":">"}],"role":"symbol","kind":"symbol","url":"\/documentation\/rkpurchasekit\/purchasesmanager\/subscriptionstatusupdates","type":"topic"},"doc://purchasekit.RKPurchaseKit/