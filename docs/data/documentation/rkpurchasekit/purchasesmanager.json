":"text"},{"text":"and the scene-based App Store sheets in ","type":"text"},{"code":"RKPurchasesManager+StoreSheets.swift","type":"codeVoice"},{"text":". The state","type":"text"},{"type":"text","text":" "},{"type":"text","text":"they share is therefore "},{"type":"codeVoice","code":"internal"},{"type":"text","text":" rather than "},{"type":"codeVoice","code":"private"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"The central ","type":"text"},{"code":"actor","type":"codeVoice"},{"text":" that drives all StoreKit 2 operations.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It handles product fetching, purchases, restoration, entitlement evaluation, subscription"},{"type":"text","text":" "},{"type":"text","text":"status and continuous transaction updates. Being an "},{"type":"codeVoice","code":"actor"},{"type":"text","text":", it is safe to use from concurrent"},{"type":"text","text":" "},{"text":"contexts (Swift Concurrency).","type":"text"}]},{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Every purchase goes through one path, "},{"isActive":true,"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/purchase(productID:options:)","type":"reference"},{"text":". The shorter calls you","type":"text"},{"text":" ","type":"text"},{"text":"already know - ","type":"text"},{"code":"purchase(productID:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"purchase(productID:appAccountToken:)","type":"codeVoice"},{"text":" - are","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"conveniences on "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol","isActive":true,"type":"reference"},{"type":"text","text":" and "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/ServerVerifiedPurchasesProtocol","isActive":true,"type":"reference"},{"type":"text","text":" that forward to"},{"type":"text","text":" "},{"type":"text","text":"it, so they cannot drift apart from the options-based call."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Every throwing method throws "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesError","isActive":true,"type":"reference"},{"type":"text","text":"; StoreKit’s own errors are translated into"},{"type":"text","text":" "},{"type":"text","text":"its codes and kept as "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesError\/underlyingError","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"On iOS and visionOS the manager also wraps StoreKit’s scene-based sheets. They run on the","type":"text"},{"type":"text","text":" "},{"text":"main actor and take the ","type":"text"},{"code":"UIWindowScene","type":"codeVoice"},{"text":" that presents them:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"showManageSubscriptions(in:groupID:)","type":"codeVoice"},{"text":" – the system’s manage-subscriptions sheet,","type":"text"},{"text":" ","type":"text"},{"text":"optionally focused on one subscription group.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"beginRefundRequest(for:in:)","type":"codeVoice"},{"text":" – the refund sheet for a transaction ID; returns a","type":"text"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/RefundRequestStatus","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"presentOfferCodeRedeemSheet(in:)"},{"type":"text","text":" – the sheet for redeeming an offer code."}]}]}]}],"kind":"content"}],"kind":"symbol","sections":[],"metadata":