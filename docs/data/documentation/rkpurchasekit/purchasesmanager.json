,"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/activeSubscription(inGroup:)"]},{"title":"Subscription status","identifiers":["doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/subscriptionStatuses(inGroup:)","doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/isEligibleForIntroOffer(inGroup:)","doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/subscriptionStatusUpdates"],"anchor":"Subscription-status"},{"title":"App purchase","identifiers":["doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/appPurchaseInfo()"],"anchor":"App-purchase"},{"title":"Events","abstract":[{"type":"text","text":"See "},{"type":"text","text":"doc:Subscriptions"},{"type":"text","text":" for status, offers and intro-offer eligibility."}],"identifiers":["doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/purchasedProducts"],"anchor":"Events"},{"title":"Default Implementations","generated":true,"identifiers":["doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/Actor-Implementations","doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/PurchasesProtocol-Implementations","doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/ServerVerifiedPurchasesProtocol-Implementations"],"anchor":"Default-Implementations"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PurchasesManager","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The manager is an "},{"type":"codeVoice","code":"actor"},{"type":"text","text":" and is therefore safe to use from concurrent contexts."},{"type":"text","text":" "},{"type":"text","text":"It holds a product cache, listens for "},{"type":"codeVoice","code":"Transaction.updates"},{"type":"text","text":" and subscription status"},{"type":"text","text":" "},{"type":"text","text":"updates, and exposes a simple API for fetching products, purchasing, restoring, and"},{"type":"text","text":" "},{"type":"text","text":"querying current entitlements and subscription state."},{"type":"text","text":" "},{"type":"text","text":"See "},{"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager","isActive":true},{"type":"text","text":" for the overview."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Split across files by topic: subscriptions live in "},{"type":"codeVoice","code":"RKPurchasesManager+Subscriptions.swift"},{"type":"text","text":" "},{"type":"text","text":"and the scene-based App Store sheets in "},{"type":"codeVoice","code":"RKPurchasesManager+StoreSheets.swift"},{"type":"text","text":". The state"},{"type":"text","text":" "},{"type":"text","text":"they share is therefore "},{"type":"codeVoice","code":"internal"},{"type":"text","text":" rather than "},{"type":"codeVoice","code":"private"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The central "},{"type":"codeVoice","code":"actor"},{"type":"text","text":" that drives all StoreKit 2 operations."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It handles product fetching, purchases, restoration, entitlement evaluation, subscription"},{"type":"text","text":" "},{"type":"text","text":"status and continuous transaction updates. Being an "},{"type":"codeVoice","code":"actor"},{"type":"text","text":", it is safe to use from concurrent"},{"type":"text","text":" "},{"type":"text","text":"contexts (Swift Concurrency)."}],"type":"paragraph"},{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Every purchase goes through one path, "},{"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/purchase(productID:options:)","isActive":true},{"type":"text","text":". The shorter calls you"},{"type":"text","text":" "},{"type":"text","text":"already know - "},{"type":"codeVoice","code":"purchase(productID:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"purchase(productID:appAccountToken:)"},{"type":"text","text":" - are"},{"type":"text","text":" "},{"type":"text","text":"conveniences on "},{"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/ServerVerifiedPurchasesProtocol","isActive":true},{"type":"text","text":" that forward to"},{"type":"text","text":" "},{"type":"text","text":"it, so they cannot drift apart from the options-based call."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Every throwing method throws "},{"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesError","isActive":true},{"type":"text","text":"; StoreKit’s own errors are translated into"},{"type":"text","text":" "},{"type":"text","text":"its codes and kept as "},{"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesError\/underlyingError","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"On iOS and visionOS the manager also wraps StoreKit’s scene-based sheets. They run on the"},{"type":"text","text":" "},{"type":"text","text":"main actor and take the "},{"type":"codeVoice","code":"UIWindowScene"},{"type":"text","text":" that presents them:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"showManageSubscriptions(in:groupID:)"},{"text":" – the system’s manage-subscriptions sheet,","type":"text"},{"text":" ","type":"text"},{"text":"optionally focused on one subscription group.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"beginRefundRequest(for:in:)"},{"type":"text","text":" – the refund sheet for a transaction ID; returns a"},{"type":"text","text":" "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/RefundRequestStatus","type":"reference","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"presentOfferCodeRedeemSheet(in:)"},{"text":" – the sheet for redeeming an offer code.","type":"text"}]}]}],"type":"unorderedList"}],"kind":"content"}],"references":{"doc://purchasekit.RKPurchaseKit/documentation/RKPurchaseKit/PurchasesManager/activeSubscriptions()":{"abstract":[{"text":"Returns all active auto-renewable subscriptions mapped to ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/StoreProduct","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"topic","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/activeSubscriptions()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"activeSubscriptions"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" -> ["},{"kind":"typeIdentifier","text":"StoreProduct","preciseIdentifier":"s:13RKPurchaseKit12StoreProductV"},{"kind":"text","text":"]"}],"title":"activeSubscriptions()","kind":"symbol","url":"\/documentation\/rkpurchasekit\/purchasesmanager\/activesubscriptions()","role":"symbol"},"doc://purchasekit.RKPurchaseKit/documentation/RKPurchaseKit/ServerVerifiedPurchasesProtocol":{"kind":"symbol","abstract":[{"type":"text","text":"The purchase flow for apps