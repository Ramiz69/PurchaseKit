:"text","text":"The central "},{"type":"codeVoice","code":"actor"},{"type":"text","text":" that drives all StoreKit 2 operations."}],"type":"paragraph"},{"inlineContent":[{"text":"It handles product fetching, purchases, restoration, entitlement evaluation, subscription","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"status and continuous transaction updates. Being an "},{"type":"codeVoice","code":"actor"},{"type":"text","text":", it is safe to use from concurrent"},{"type":"text","text":" "},{"type":"text","text":"contexts (Swift Concurrency)."}],"type":"paragraph"},{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"inlineContent":[{"text":"Every purchase goes through one path, ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager\/purchase(productID:options:)","type":"reference","isActive":true},{"text":". The shorter calls you","type":"text"},{"text":" ","type":"text"},{"text":"already know - ","type":"text"},{"code":"purchase(productID:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"purchase(productID:appAccountToken:)","type":"codeVoice"},{"text":" - are","type":"text"},{"text":" ","type":"text"},{"text":"conveniences on ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/ServerVerifiedPurchasesProtocol","type":"reference","isActive":true},{"text":" that forward to","type":"text"},{"text":" ","type":"text"},{"text":"it, so they cannot drift apart from the options-based call.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Every throwing method throws "},{"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesError","isActive":true},{"type":"text","text":"; StoreKit’s own errors are translated into"},{"type":"text","text":" "},{"type":"text","text":"its codes and kept as "},{"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesError\/underlyingError","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"On iOS and visionOS the manager also wraps StoreKit’s scene-based sheets. They run on the"},{"type":"text","text":" "},{"type":"text","text":"main actor and take the "},{"type":"codeVoice","code":"UIWindowScene"},{"type":"text","text":" that presents them:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"showManageSubscriptions(in:groupID:)","type":"codeVoice"},{"type":"text","text":" – the system’s manage-subscriptions sheet,"},{"type":"text","text":" "},{"type":"text","text":"optionally focused on one subscription group."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"beginRefundRequest(for:in:)","type":"codeVoice"},{"type":"text","text":" – the refund sheet for a transaction ID; returns a"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/RefundRequestStatus"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"presentOfferCodeRedeemSheet(in:)"},{"text":" – the sheet for redeeming an offer code.","type":"text"}],"type":"paragraph"}]}]}]}],"kind":"symbol","identifier":{"url":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager","interfaceLanguage":"swift"},"metadata":{"title":"PurchasesManager","externalID":"s:13RKPurchaseKit16PurchasesManagerC","role":"symbol","symbolKind":"class","roleHeading":"Class","navigatorTitle":[{"kind":"identifier","text":"PurchasesManager"}],"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PurchasesManager","kind":"identifier