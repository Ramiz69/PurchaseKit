mentions":["doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/GettingStarted","doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/MigratingTo4"],"kind":"mentions"},{"content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Requirements are kept to what a stand-in genuinely has to decide. Every shorter call -","type":"text"},{"type":"text","text":" "},{"type":"text","text":"a purchase without options, products with the cache, the single status of a group - is an"},{"type":"text","text":" "},{"type":"text","text":"extension method that forwards to a requirement, so a mock cannot answer one differently"},{"type":"text","text":" "},{"type":"text","text":"from the other and every new convenience is free for existing conformers."}]},{"inlineContent":[{"type":"text","text":"An abstraction that lets you swap "},{"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager","isActive":true},{"type":"text","text":" for a mock implementation in unit tests or previews."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The protocol mirrors the public surface of the manager and adds high-level helpers for entitlements and subscriptions."}],"type":"paragraph"},{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"A conforming type implements the requirements; everything listed under","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"Conveniences"}],"type":"emphasis"},{"text":" is provided by an extension and forwards to a requirement. In particular,","type":"text"},{"text":" ","type":"text"},{"code":"purchase(productID:)","type":"codeVoice"},{"text":" is not a requirement: it calls","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol\/purchase(productID:options:)"},{"text":" with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchaseOptions\/none"},{"text":". A mock implements the","type":"text"},{"text":" ","type":"text"},{"text":"options-based call and gets the short one for free.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct PurchasesMock: PurchasesProtocol {","    func requestProducts(includingCache: Bool) async throws -> [StoreProduct] { [] }","    func purchase(","        productID: String,","        options: PurchaseOptions","    ) async throws -> (product: StoreProduct, transaction: StoreTransaction) {","        throw PurchasesError(.purchaseCancelled)","    }","    func restore() async throws { }","    func hasEntitlement(for productID: String) async -> Bool { productID == \"com.myapp.pro\" }","    func entitlementProductIDs() async -> Set<String> { [\"com.myapp.pro\"] }","    func activeSubscriptions() async -> [StoreProduct] { [] }","    func activeSubscription(inGroup groupID: String) async -> StoreProduct? { nil }","    func subscriptionStatuses(inGroup groupID: String) async throws -> [StoreSubscriptionStatus] { [] }","    func isEligibleForIntroOffer(inGroup groupID: String) async -> Bool { true }","    func appPurchaseInfo() async throws -> AppPurchaseInfo { throw PurchasesError(.unsupported) }","}"],"type":"codeListing"},{"style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Do not keep a "},{"type":"codeVoice","code":"purchase(productID:)"},{"text":" of your own in a conformer. It no longer","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"satisfies a requirement, so a call made through "},{"type":"codeVoice","code":"any PurchasesProtocol"},{"type":"text","text":" skips it and runs"},{"type":"text","text":" "},{"type":"text","text":"the extension, which calls your "},{"type":"reference","isActive":true,"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol\/purchase(productID:options:)"},{"type":"text","text":"."}]}],"type":"aside"},{"type":"paragraph","inlineContent":[{"text":"On visionOS the purchase requirement is ","type":"text"},{"code":"purchase(productID:options:confirmIn:)","type":"codeVoice"},{"text":", which takes","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"UIScene","type":"codeVoice"},{"text":" that presents the App Store confirmation, and the convenience is","type":"text"},{"text":" ","type":"text"},{"code":"purchase(productID:confirmIn:)","type":"codeVoice"},{"text":".","type":"text"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit"]]},"abstract":[{"type":"text","text":"Protocol abstraction to allow mocking in tests."},{"type":"text","text":" "},{"type":"text","text":"Full spec: "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol","isActive":true,"type":"reference"}],"references":{"doc://purchasekit.RKPurchaseKit/documentation/RKPurchaseKit/PurchaseOptions":{"role":"symbol","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchaseOptions","url":"\/documentation\/rkpurchasekit\/purchaseoptions","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PurchaseOptions","kind":"identifier"}],"title":"PurchaseOptions","type":"topic","navigatorTitle":[{"text":"PurchaseOptions","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"Everything a purchase can carry besides the product: an account token, a quantity, an","type":"text"},{"text":" ","type":"text"},{"text":"offer, and sandbox switches.","type":"text"}]},"doc://purchasekit.RKPurchaseKit/documentation/RKPurchaseKit/PurchasesProtocol/hasEntitlement(for:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identi