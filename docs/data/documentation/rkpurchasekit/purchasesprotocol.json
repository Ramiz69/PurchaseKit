haseKit\/documentation\/RKPurchaseKit\/GettingStarted","doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/MigratingTo4"],"kind":"mentions"},{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"Requirements are kept to what a stand-in genuinely has to decide. Every shorter call -"},{"type":"text","text":" "},{"text":"a purchase without options, products with the cache, the single status of a group - is an","type":"text"},{"text":" ","type":"text"},{"text":"extension method that forwards to a requirement, so a mock cannot answer one differently","type":"text"},{"text":" ","type":"text"},{"text":"from the other and every new convenience is free for existing conformers.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"An abstraction that lets you swap ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager"},{"text":" for a mock implementation in unit tests or previews.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The protocol mirrors the public surface of the manager and adds high-level helpers for entitlements and subscriptions.","type":"text"}],"type":"paragraph"},{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"A conforming type implements the requirements; everything listed under","type":"text"},{"text":" ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"Conveniences"}]},{"text":" is provided by an extension and forwards to a requirement. In particular,","type":"text"},{"text":" ","type":"text"},{"code":"purchase(productID:)","type":"codeVoice"},{"text":" is not a requirement: it calls","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol\/purchase(productID:options:)"},{"text":" with ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchaseOptions\/none"},{"text":". A mock implements the","type":"text"},{"text":" ","type":"text"},{"text":"options-based call and gets the short one for free.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct PurchasesMock: PurchasesProtocol {","    func requestProducts(includingCache: Bool) async throws -> [StoreProduct] { [] }","    func purchase(","        productID: String,","        options: PurchaseOptions","    ) async throws -> (product: StoreProduct, transaction: StoreTransaction) {","        throw PurchasesError(.purchaseCancelled)","    }","    func restore() async throws { }","    func hasEntitlement(for productID: String) async -> Bool { productID == \"com.myapp.pro\" }","    func entitlementProductIDs() async -> Set<String> { [\"com.myapp.pro\"] }","    func activeSubscriptions() async -> [StoreProduct] { [] }","    func activeSubscription(inGroup groupID: String) async -> StoreProduct? { nil }","    func subscriptionStatuses(inGroup groupID: String) async throws -> [StoreSubscriptionStatus] { [] }","    func isEligibleForIntroOffer(inGroup groupID: String) async -> Bool { true }","    func appPurchaseInfo() async throws -> AppPurchaseInfo { throw PurchasesError(.unsupported) }","}"]},{"name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Do not keep a "},{"code":"purchase(productID:)","type":"codeVoice"},{"type":"text","text":" of your own in a conformer. It no longer"},{"type":"text","text":" "},{"type":"text","text":"satisfies a requirement, so a call made through "},{"code":"any PurchasesProtocol","type":"codeVoice"},{"type":"text","text":" skips it and runs"},{"type":"text","text":" "},{"type":"text","text":"the extension, which calls your "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol\/purchase(productID:options:)","type":"reference","isActive":true},{"type":"text","text":"."}]}],"type":"aside","style":"important"},{"inlineContent":[{"text":"On visionOS the purchase requirement is ","type":"text"},{"code":"purchase(productID:options:confirmIn:)","type":"codeVoice"},{"text":", which takes","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"UIScene","type":"codeVoice"},{"text":" that presents the App Store confirmation, and the convenience is","type":"text"},{"text":" ","type":"text"},{"code":"purchase(productID:confirmIn:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"seeAlsoSections":[{"title":"Purchasing","anchor":"Purchasing","identifiers":["doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager","doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/ServerVerifiedPurchasesProtocol","doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchaseOptions","doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/FinishPolicy","doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesError"],"generated":true}],"references":{"doc://purchasekit.RKPurchaseKit/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/s16SendableMetatypeP","type":"unresolvable"},"doc://purchasekit.RKPurchaseKit/documentation/RKPurchaseKit/PurchasesError":{"title":"PurchasesError","abstract":[{"type":"text","text":"The error every throwing call in the SDK throws."}],"url":"\/documentation\/rkpurchasekit\/purchaseserror","identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesError","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"PurchasesError"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PurchasesError"}]},"doc://purchasekit.R