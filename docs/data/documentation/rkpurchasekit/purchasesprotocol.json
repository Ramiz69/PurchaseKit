{"relationshipsSections":[{"title":"Inherits From","identifiers":["doc:\/\/purchasekit.RKPurchaseKit\/s8SendableP","doc:\/\/purchasekit.RKPurchaseKit\/s16SendableMetatypeP"],"kind":"relationships","type":"inheritsFrom"},{"title":"Inherited By","identifiers":["doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/ServerVerifiedPurchasesProtocol"],"kind":"relationships","type":"inheritedBy"},{"title":"Conforming Types","identifiers":["doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager"],"kind":"relationships","type":"conformingTypes"}],"abstract":[{"text":"Protocol abstraction to allow mocking in tests.","type":"text"},{"text":" ","type":"text"},{"text":"Full spec: ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol","type":"reference","isActive":true}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PurchasesProtocol","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Sendable","preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier"}],"platforms":["macOS"]}],"kind":"declarations"},{"mentions":["doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/GettingStarted","doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/MigratingTo4"],"kind":"mentions"},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"text":"Requirements are kept to what a stand-in genuinely has to decide. Every shorter call -","type":"text"},{"text":" ","type":"text"},{"text":"a purchase without options, products with the cache, the single status of a group - is an","type":"text"},{"text":" ","type":"text"},{"text":"extension method that forwards to a requirement, so a mock cannot answer one differently","type":"text"},{"text":" ","type":"text"},{"text":"from the other and every new convenience is free for existing conformers.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"An abstraction that lets you swap ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager","type":"reference","isActive":true},{"text":" for a mock implementation in unit tests or previews.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The protocol mirrors the public surface of the manager and adds high-level helpers for entitlements and subscriptions.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"A conforming type implements the requirements; everything listed under","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"Conveniences","type":"text"}],"type":"emphasis"},{"text":" is provided by an extension and forwards to a requirement. In particular,","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"purchase(productID:)"},{"text":" is not a requirement: it calls","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol\/purchase(productID:options:)","type":"reference","isActive":true},{"text":" with ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchaseOptions\/none","type":"reference","isActive":true},{"text":". A mock implements the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"options-based call and gets the short one for free."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct PurchasesMock: PurchasesProtocol {","    func requestProducts(includingCache: Bool) async throws -> [StoreProduct] { [] }","    func purchase(","        productID: String,","        options: PurchaseOptions","    ) async throws -> (product: StoreProduct, transaction: StoreTransaction) {","        throw PurchasesError(.purchaseCancelled)","    }","    func restore() async throws { }","    func hasEntitlement(for productID: String) async -> Bool { productID == \"com.myapp.pro\" }","    func entitlementProductIDs() async -> Set<String> { [\"com.myapp.pro\"] }","    func activeSubscriptions() async -> [StoreProduct] { [] }","    func activeSubscription(inGroup groupID: String) async -> StoreProduct? { nil }","    func subscriptionStatuses(inGroup groupID: String) async throws -> [StoreSubscriptionStatus] { [] }","    func isEligibleForIntroOffer(inGroup groupID: String) async -> Bool { true }","    func appPurchaseInfo() async throws -> AppPurchaseInfo { throw PurchasesError(.unsupported) }","}"]},{"style":"important","name":"Important","content":[{"inlineContent":[{"text":"Do not keep a ","type":"text"},{"code":"purchase(productID:)","type":"codeVoice"},{"text":" of your own in a conformer. It no longer","type":"text"},{"text":" ","type":"text"},{"text":"satisfies a requirement, so a call made through ","type":"text"},{"code":"any PurchasesProtocol","type":"codeVoice"},{"text":" skips it and runs","type":"text"},{"text":" ","type":"text"},{"text":"the extension, which calls your ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol\/purchase(productID:options:)","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"type":"aside"},{"inlineContent":[{"text":"On visionOS the purchase requirement is ","type":"text"},{"code":"purchase(productID:options:confirmIn:)","type":"codeVoice"},{"text":", which takes","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"UIScene","type":"codeVoice"},{"text":" that presents the App Store confirmation, and the convenience is","type":"text"},{"text":" ","type":"text"},{"code":"purchase(productID:confirmIn:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"modules":[{"name":"PurchaseKit"}],"fragments":[{"tex