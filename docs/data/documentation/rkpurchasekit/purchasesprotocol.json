{"variants":[{"paths":["\/documentation\/rkpurchasekit\/purchasesprotocol"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"relationshipsSections":[{"identifiers":["doc:\/\/purchasekit.RKPurchaseKit\/s8SendableP","doc:\/\/purchasekit.RKPurchaseKit\/s16SendableMetatypeP"],"type":"inheritsFrom","kind":"relationships","title":"Inherits From"},{"identifiers":["doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/ServerVerifiedPurchasesProtocol"],"type":"inheritedBy","kind":"relationships","title":"Inherited By"},{"identifiers":["doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager"],"type":"conformingTypes","kind":"relationships","title":"Conforming Types"}],"metadata":{"externalID":"s:13RKPurchaseKit17PurchasesProtocolP","modules":[{"name":"PurchaseKit"}],"title":"PurchasesProtocol","roleHeading":"Protocol","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PurchasesProtocol"}],"navigatorTitle":[{"kind":"identifier","text":"PurchasesProtocol"}],"symbolKind":"protocol"},"kind":"symbol","topicSections":[{"anchor":"Core-Methods","identifiers":["doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol\/requestProducts(includingCache:)","doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol\/purchase(productID:options:)","doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol\/restore()"],"title":"Core Methods"},{"anchor":"Entitlements--Subscriptions","identifiers":["doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol\/hasEntitlement(for:)","doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol\/entitlementProductIDs()","doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol\/activeSubscriptions()","doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol\/acti