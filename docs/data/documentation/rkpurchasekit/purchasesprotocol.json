{"hierarchy":{"paths":[["doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol","interfaceLanguage":"swift"},"abstract":[{"text":"Protocol abstraction to allow mocking in tests.","type":"text"},{"text":" ","type":"text"},{"text":"Full spec: ","type":"text"},{"isActive":true,"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol","type":"reference"}],"topicSections":[{"title":"Core Methods","identifiers":["doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol\/requestProducts(includingCache:)","doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol\/purchase(productID:options:)","doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol\/restore()"],"anchor":"Core-Methods"},{"title":"Entitlements & Subscriptions","identifiers":["doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol\/hasEntitlement(for:)","doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol\/currentEntitlement(for:)","doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol\/entitlementProductIDs()","doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol\/activeSubscriptions()","doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol\/activeSubscription(inGroup:)"],"anchor":"Entitlements--Subscriptions"},{"title":"Subscription status","identifiers":["doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol\/subscriptionStatuses(inGroup:)","doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol\/isEligibleForIntroOffer(inGroup:)"],"anchor":"Subscription-status"},{"title":"App purchase","identifiers":["doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol\/appPurchaseInfo()"],"anchor":"App-purchase"},{"title":"Conveniences","identifiers":["doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol\/requestProducts()","doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol\/purchase(productID:)","doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol\/subscriptionStatus(inGroup:)"],"anchor":"Conveniences"}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PurchasesProtocol"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Sendable","preciseIdentifier":"s:s8SendableP"}]}]},{"mentions":["doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/GettingStarted","doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/MigratingTo4"],"kind":"mentions"},{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Requirements are kept to what a stand-in genuinely has to decide. Every shorter call -","type":"text"},{"text":" ","type":"text"},{"text":"a purchase without options, products with the cache, the single status of a group - is an","type":"text"},{"text":" ","type":"text"},{"text":"extension method that forwards to a requirement, so a mock cannot answer one differently","type":"text"},{"text":" ","type":"text"},{"text":"from the other and every new convenience is free for existing conformers.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"An abstraction that lets you swap ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager","type":"reference","isActive":true},{"text":" for a mock implementation in unit tests or previews.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The protocol mirrors the public surface of the manager and adds high-level helpers for entitlements and subscriptions.","type":"text"}]},{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A conforming type implements the requirements; everything listed under","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"Conveniences"}],"type":"emphasis"},{"text":" is provided by an extension and forwards to a requirement. In particular,","type":"text"},{"text":" ","type":"text"},{"code":"purchase(productID:)","type":"codeVoice"},{"text":" is not a requirement: it calls","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol\/purchase(productID:options:)","type":"reference","isActive":true},{"text":" with ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchaseOptions\/none","type":"reference","isActive":true},{"text":". A mock implements the","type":"text"},{"text":" ","type":"text"},{"text":"options-based call and gets the short one for free.","type":"text"}]},{"syntax":"swift","code":["struct PurchasesMock: PurchasesProtocol {","    func requestProducts(includingCache: Bool) async throws -> [StoreProduct] { [] }","    func purchase(","        productID: String,","        options: PurchaseOptions","    ) async throws -> (product: StoreProduct, transaction: StoreTransaction) {","        throw PurchasesError(.purchaseCancelled)","    }","    func restore() async throws { }","    func hasEntitlement(for productID: String) async -> Bool { productID == \"com.myapp.pro\" }","    func entitlementProductIDs() async -> Set<String> { [\"com.myapp.pro\"] }","    func activeSubscriptions() async -> [StoreProduct] { [] }","    func activeSubscription(inGroup groupID: String) async -> StoreProduct? { nil }","    func subscriptionStatuses(inGroup groupID: String) async throws -> [StoreSubscriptionStatus] { [] }","    func isEligibleForIntroOffer(inGroup groupID: String) async -> Bool { true }","    func appPurchaseInfo() async throws -> AppPurchaseInfo { throw PurchasesError(.unsupported) }","}"],"type":"codeListing"},{"name":"Important","style":"important","type":"aside","content":[{"inlineContent":[{"type":"text","text":"Do not keep a "},{"type":"codeVoice","code":"purchase(productID:)"},{"type":"text","text":" of your own in a conformer. It no longer"},{"type":"text","text":" "},{"type":"text","text":"satisfies a requirement, so a call made through "},{"type":"codeVoice","code":"any PurchasesProtocol"},{"type":"text","text":" skips it and runs"},{"type":"text","text":" "},{"type":"text","text":"the extension, which calls your "},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol\/purchase(productID:options:)","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"}]},{"type":"paragraph","inlineContent":[{"text":"On visionOS the purchase requirement is ","type":"text"},{"code":"purchase(productID:options:confirmIn:)","type":"codeVoice"},{"text":", which takes","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"UIScene","type":"codeVoice"},{"text":" that presents the App Store confirmation, and the convenience is","type":"text"},{"text":" ","type":"text"},{"code":"purchase(productID:confirmIn:)","type":"codeVoice"},{"text":".","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/rkpurchasekit\/purchasesprotocol"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"generated":true,"title":"Purchasing","identifiers":["doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesManager","doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/ServerVerifiedPurchasesProtocol","doc:\/\/purchasekit.RKPurchaseKit\/documentat