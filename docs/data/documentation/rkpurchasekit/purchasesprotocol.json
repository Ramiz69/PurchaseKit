e(productID:)"},{"text":" of your own in a conformer. It no longer","type":"text"},{"text":" ","type":"text"},{"text":"satisfies a requirement, so a call made through ","type":"text"},{"type":"codeVoice","code":"any PurchasesProtocol"},{"text":" skips it and runs","type":"text"},{"text":" ","type":"text"},{"text":"the extension, which calls your ","type":"text"},{"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol\/purchase(productID:options:)","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"Important","style":"important"},{"type":"paragraph","inlineContent":[{"text":"On visionOS the purchase requirement is ","type":"text"},{"code":"purchase(productID:options:confirmIn:)","type":"codeVoice"},{"text":", which takes","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"UIScene","type":"codeVoice"},{"text":" that presents the App Store confirmation, and the convenience is","type":"text"},{"text":" ","type":"text"},{"code":"purchase(productID:confirmIn:)","type":"codeVoice"},{"text":".","type":"text"}]}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"Protocol abstraction to allow mocking in tests.","type":"text"},{"text":" ","type":"text"},{"text":"Full spec: ","type":"text"},{"isActive":true,"identifier":"doc:\/\/purchasekit.RKPurchaseKit\/documentation\/RKPurchaseKit\/PurchasesProtocol","type":"reference"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/rkpurchasekit\/purchasesprotocol"]}],"sections":[],"metadata":{"externalID":"s:13RKPurchaseKit17PurchasesProtocolP","roleHeading":"Protocol","modules":[{"name":"PurchaseKit"}],"navigatorTitle":[{"kind":"identifier","text":"PurchasesProtocol"}],"title":"PurchasesProtocol","symbolKind":"protocol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PurchasesProtocol"}],"role":"symbol"},"seeAlsoSe